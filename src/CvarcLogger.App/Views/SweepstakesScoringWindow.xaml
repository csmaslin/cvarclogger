<Window x:Class="CvarcLogger.App.Views.SweepstakesScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="ARRL Sweepstakes Scoring" Icon="/Assets/AppIcon.ico"
        Height="820" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#404040" Padding="24,16">
            <StackPanel>
                <emoji:TextBlock Text="🌐" FontSize="32" Foreground="White"/>
                <TextBlock Text="ARRL Sweepstakes" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                <TextBlock Text="Separate CW and Phone event scoring" FontSize="13" Foreground="#bdc3c7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel>
                <!-- Year selection -->
                <Border BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,16" Margin="0,0,0,24">
                    <DockPanel>
                        <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="YearTextBox" Width="100" Text="2026" Padding="8,6"/>
                        <Button Content="Load" Margin="8,0,0,0" Padding="16,6" HorizontalAlignment="Left" Click="LoadButton_Click"/>
                        <TextBlock Text="(Loads QSOs from specified year)" Foreground="#999999" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                </Border>

                <!-- CW Event Section -->
                <TextBlock Text="CW Event" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="First full weekend of November, Saturday 21:00 UTC – Monday 02:59 UTC" Style="{StaticResource MetricLabel}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CW QSOs -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- CW Sections -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Sections" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwSectionCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- CW Score -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <!-- Phone Event Section -->
                <TextBlock Text="Phone Event" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Third full weekend of November, Saturday 21:00 UTC – Monday 02:59 UTC" Style="{StaticResource MetricLabel}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Phone QSOs -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PhoneQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- Phone Sections -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Sections" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PhoneSectionCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- Phone Score -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PhoneScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <!-- Total Section -->
                <TextBlock Text="Combined Total" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total QSOs -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Total QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- Total Sections -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Total Sections (max 85)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalSectionCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- Final Score -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Final Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalScore, Mode=OneWay}"
                                   FontSize="28" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Formula: (CW QSOs × CW Sections) + (Phone QSOs × Phone Sections)"
                           FontSize="11" Foreground="#999999" FontStyle="Italic" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
