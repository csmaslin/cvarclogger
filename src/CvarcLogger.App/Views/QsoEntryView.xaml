<UserControl x:Class="CvarcLogger.App.Views.QsoEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="800"
             KeyDown="QsoEntryView_KeyDown">
    <UserControl.Resources>
        <!-- Fields stretch to fill their FieldsGrid column rather than carrying a fixed width. The old
             fixed Width="215" was a leftover from when these lived in a WrapPanel; once they moved into
             the 6-column Grid (every column Width="*"), any window narrow enough to make a column less
             than 215px wide clipped each field's right edge. That was most visible on Callsign, whose
             header carries the "Dupe Check" checkbox alongside the label. Stretching also keeps fields
             sized consistently with each other as the window is resized. -->
        <Style x:Key="FieldBox" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#E8F4FC" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Form Title -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding EntryFormTitle}"
                          FontSize="16" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" Content="Lock Fields" IsChecked="{Binding LockFieldsForCurrentMode, Mode=TwoWay}"
                         FontSize="13" Foreground="#000000" VerticalAlignment="Center"
                         ToolTip="Checked, fields on this mode's entry form can't be dragged to a new position: prevents an accidental drag from nudging one out of place"/>
            </Grid>
        </Border>

        <!-- Form Content: no ScrollViewer here. MainWindow.xaml already wraps this whole UserControl in
             one, and a second, nested ScrollViewer around just this part caused mouse-wheel scrolling to
             stop working over the fields (the inner one silently swallows/handles wheel input first;
             reaching the outer scrollbar required literally grabbing it with the mouse). Row 1 is Auto
             height, not *, so the Grid sizes to its natural content height and leaves the actual
             scrolling decision to the one outer ScrollViewer. -->
        <Grid Grid.Row="1">
            <!-- Empty-state hint, shown only while this mode has no fields checked on at all (see
                 QsoEntryView.xaml.cs UpdateEmptyStateHint). Sits in the same cell as the fields grid
                 below rather than in the StackPanel flow, so it overlays the empty grid instead of
                 pushing it down; IsHitTestVisible=False keeps it from eating drag/drop or click input
                 aimed at the grid underneath. -->
            <TextBlock x:Name="EmptyStateHint" Text="Select columns/tabs needed"
                       FontSize="20" Foreground="#A8BDD0" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,40,0,40" IsHitTestVisible="False"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Vertical">
                <!-- Field layout grid: each field's Grid.Row/Grid.Column is assigned in code-behind
                     (QsoEntryView.xaml.cs ApplyFieldLayout) from the saved per-mode row/position (see
                     SettingsService.GetEntryFormFieldPositions), falling back to DefaultPositions there
                     for any field never dragged. 5 columns match the established "max 5 fields per row"
                     cap. RowDefinitions carry a small MinHeight so rows with nothing in them yet are
                     still a reachable drop target (a pure Auto row with no content collapses to zero
                     height, making it impossible to drag a field into). Drag-and-drop (stage 3): drag a
                     field by its label onto another field to swap them, or onto empty space to move it
                     there, see FieldsGrid_PreviewMouseLeftButtonDown/PreviewMouseMove/Drop in the
                     code-behind. Background="Transparent" is required for empty cells to be hit-testable
                     (a null background lets pointer events pass straight through). -->
                <Grid x:Name="FieldsGrid" Background="Transparent" AllowDrop="True"
                      PreviewMouseLeftButtonDown="FieldsGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FieldsGrid_PreviewMouseMove"
                      DragOver="FieldsGrid_DragOver"
                      Drop="FieldsGrid_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                        <RowDefinition Height="Auto" MinHeight="20"/>
                    </Grid.RowDefinitions>

                    <!-- Station -->
                    <StackPanel x:Name="StationField" Style="{StaticResource FieldBox}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="STATION" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 SelectedValuePath="Callsign" ItemsSource="{Binding StationProfiles}"
                                 SelectedItem="{Binding SelectedStationProfile, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Callsign}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Callsign -->
                    <StackPanel x:Name="CallsignField" Style="{StaticResource FieldBox}">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CALLSIGN" FontSize="12" FontWeight="Bold" Foreground="#555555" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Content="Dupe Check" IsChecked="{Binding DupeCheckEnabled, Mode=TwoWay}"
                                     FontSize="11" Foreground="#555555" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     ToolTip="While checked, whatever you type in Callsign is copied live into the log grid's search box, so you can spot a duplicate before logging"/>
                        </Grid>
                        <TextBox x:Name="CallsignTextBox" Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Callsign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="W5XYZ"
                                PreviewKeyDown="CallsignField_PreviewKeyDown"/>
                    </StackPanel>

                    <!-- Date/Time UTC -->
                    <StackPanel x:Name="UtcTimeField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowUtcTimeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="DATE/TIME UTC" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoDateTimeUtcText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <!-- Band -->
                    <StackPanel x:Name="BandField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowBandField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="BAND" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding BandIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding Bands}" Text="{Binding Band, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- Freq -->
                    <StackPanel x:Name="FreqField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowFreqField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="FREQ (MHZ)" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding FreqIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding FrequencyMhz, Mode=TwoWay}" Tag="14.200"/>
                    </StackPanel>

                    <!-- Mode -->
                    <StackPanel x:Name="ModeField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowModeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MODE" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding ModeIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding Modes}" Text="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- Sub-Mode -->
                    <StackPanel x:Name="SubModeField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowSubModeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="SUB-MODE" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding SubModeIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding SubModes}" Text="{Binding SubMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- Local Time -->
                    <StackPanel x:Name="LocalTimeField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowLocalTimeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="LOCAL TIME" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoDateTimeLocalText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <!-- Time Off -->
                    <StackPanel x:Name="TimeOffField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowTimeOffField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="TIME OFF (UTC)" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoDateTimeOffUtcText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <!-- RST Sent -->
                    <StackPanel x:Name="RstSentField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowRstField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="RST SENT" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding RstSentIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding RstSent, Mode=TwoWay}" Tag="599"/>
                    </StackPanel>

                    <!-- RST Rcvd -->
                    <StackPanel x:Name="RstRcvdField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowRstField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="RST RCVD" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding RstRcvdIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding RstRcvd, Mode=TwoWay}" Tag="599"/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel x:Name="NameField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowNameField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="NAME" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Name, Mode=TwoWay}" Tag="John"/>
                    </StackPanel>

                    <!-- Grid -->
                    <StackPanel x:Name="GridField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowGridField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="GRID" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding GridSquare, Mode=TwoWay}" Tag="DN70"/>
                    </StackPanel>

                    <!-- City -->
                    <StackPanel x:Name="CityField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowCityField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CITY" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding City, Mode=TwoWay}" Tag="Dallas"/>
                    </StackPanel>

                    <!-- State -->
                    <StackPanel x:Name="StateField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowStateField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="STATE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding State, Mode=TwoWay}" Tag="TX"/>
                    </StackPanel>

                    <!-- County -->
                    <StackPanel x:Name="CountyField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowCountyField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="COUNTY" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding County, Mode=TwoWay}" Tag="Dallas County"/>
                    </StackPanel>

                    <!-- Country -->
                    <StackPanel x:Name="CountryField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowCountryField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="COUNTRY" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Country, Mode=TwoWay}" Tag="USA"/>
                    </StackPanel>

                    <!-- ARRL Section -->
                    <StackPanel x:Name="ArrlSectionField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowArrlSectionField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ARRL SECTION" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding ArrlSection, Mode=TwoWay}" Tag="NTX"/>
                    </StackPanel>

                    <!-- CQ Zone -->
                    <StackPanel x:Name="CqZoneField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowCqZoneField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CQ ZONE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding CqZone, Mode=TwoWay}" Tag="5"/>
                    </StackPanel>

                    <!-- ITU Zone -->
                    <StackPanel x:Name="ItuZoneField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowItuZoneField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ITU ZONE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding ItuZone, Mode=TwoWay}" Tag="27"/>
                    </StackPanel>

                    <!-- Comment -->
                    <StackPanel x:Name="CommentField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowCommentField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="COMMENT" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                TextAlignment="Left" Text="{Binding Comment, Mode=TwoWay}" Tag="Strong signal"/>
                    </StackPanel>

                    <!-- Operator -->
                    <StackPanel x:Name="OpField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowOpField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="OP" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding OpIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Op, Mode=TwoWay}" Tag="W5ABC"/>
                    </StackPanel>

                    <!-- TX Power -->
                    <StackPanel x:Name="TxPowerField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowTxPowerField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="TX(W)" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding TxPowerIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding TxPowerWatts, Mode=TwoWay}" Tag="100"/>
                    </StackPanel>

                    <!-- QTH: sticky, same rationale as OP/TX(W) above (see QsoEntryViewModel.SeedStationDefaults). -->
                    <StackPanel x:Name="QthField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowQthField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="QTH" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Qth, Mode=TwoWay}" Tag="Home"/>
                    </StackPanel>

                    <!-- Freq Rx (split operation) -->
                    <StackPanel x:Name="FreqRxField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowFreqRxField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="FREQ RX (MHZ)" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding FrequencyRxMhz, Mode=TwoWay}" Tag="14.200"/>
                    </StackPanel>

                    <!-- Continent -->
                    <StackPanel x:Name="ContinentField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowContinentField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CONTINENT" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Continent, Mode=TwoWay}" Tag="NA"/>
                    </StackPanel>

                    <!-- My Grid: sticky, same rationale as QTH above. -->
                    <StackPanel x:Name="MyGridField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowMyGridField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MY GRID" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding MyGridIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding MyGridSquare, Mode=TwoWay}" Tag="DN70"/>
                    </StackPanel>

                    <!-- My State: sticky, same rationale as QTH above. -->
                    <StackPanel x:Name="MyStateField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowMyStateField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MY STATE" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding MyStateIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding MyState, Mode=TwoWay}" Tag="TX"/>
                    </StackPanel>

                    <!-- My County: sticky, same rationale as QTH above. -->
                    <StackPanel x:Name="MyCountyField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowMyCountyField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MY COUNTY" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding MyCounty, Mode=TwoWay}" Tag="Dallas County"/>
                    </StackPanel>

                    <!-- QSL Sent/Rcvd: one visibility flag (ShowQslField) drives two separate draggable
                         slots, same precedent as RST Sent/RST Rcvd above. -->
                    <StackPanel x:Name="QslSentField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowQslField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="QSL SENT" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <ComboBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslSent, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel x:Name="QslRcvdField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowQslField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="QSL RCVD" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <ComboBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslRcvd, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- LoTW Sent/Rcvd: same one-flag/two-slots precedent as QSL Sent/Rcvd above. -->
                    <StackPanel x:Name="LotwQslSentField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowLotwField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="LOTW SENT" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <ComboBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslSent, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel x:Name="LotwQslRcvdField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowLotwField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="LOTW RCVD" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <ComboBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslRcvd, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- SKCC #: per-QSO, same narrowed-field-plus-refresh-button layout as SOTA/POTA
                         above. Resolves against the local SKCC roster (SkccRefDatabase) as you type, so a
                         mis-copied digit is obvious immediately instead of only surfacing later. -->
                    <StackPanel x:Name="SkccField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowSkccField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="SKCC #" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <!-- Grid, not a horizontal StackPanel: the text box takes whatever width is left
                             after the fixed-size badge and refresh button, so the row fits its Grid
                             column instead of overflowing it at narrower window widths. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                    Text="{Binding SkccNr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="12345"/>
                            <!-- Member tier badge: C/T/S suffix on the SKCC # itself, i.e. Centurion,
                                 Tribune, or Senator (see QsoEntryViewModel.SkccTierBadgeText). -->
                            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Margin="6,0,0,0"
                                   Background="{Binding SkccTierBadgeBrush}" Visibility="{Binding ShowSkccTierBadge}"
                                   ToolTip="SKCC member tier">
                                <TextBlock Text="{Binding SkccTierBadgeText}" FontSize="13" FontWeight="Bold"
                                          Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="2" Content="⟳" Command="{Binding UpdateSkccDbCommand}" FontSize="16"
                                   ToolTip="Update the local SKCC member database" Width="34" Padding="0"
                                   Background="#3498db" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
                        </Grid>
                        <!-- Resolved callsign/name/location from the local SKCC database (see
                             QsoEntryViewModel.ResolveSkccNrAsync). -->
                        <TextBlock Text="{Binding SkccLookupText}" FontSize="10" Foreground="#2980b9"
                                  Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowSkccLookupText}"/>
                        <!-- Live readback of the exchange gathered so far for this QSO: callsign, RST
                             received, state, name, SKCC #. See QsoEntryViewModel.SkccExchangePreview. -->
                        <TextBlock Text="{Binding SkccExchangePreview}" FontSize="11" FontWeight="Bold" Foreground="#2E7D32"
                                  Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding ShowSkccExchangePreview}"/>
                    </StackPanel>

                    <!-- My SKCC #: sticky, same rationale as QTH above. -->
                    <StackPanel x:Name="MySkccField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowMySkccField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MY SKCC #" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding MySkccNr, Mode=TwoWay}" Tag="12345"/>
                    </StackPanel>

                    <!-- Precedence -->
                    <StackPanel x:Name="PrecedenceField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowPrecedenceField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="PRECEDENCE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <ComboBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding PrecedenceOptions}" SelectedItem="{Binding SelectedPrecedenceOption, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Check -->
                    <StackPanel x:Name="CheckField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowCheckField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CHECK" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Check, Mode=TwoWay}" Tag="26"/>
                    </StackPanel>

                    <!-- Class -->
                    <StackPanel x:Name="ClassField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowClassField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CLASS" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoClass, Mode=TwoWay}" Tag="A"/>
                    </StackPanel>

                    <!-- My SOTA: sticky, same rationale as QTH above. Warning label is soft validation only,
                         see QsoEntryViewModel.IsMySotaRefValid, never blocks Log QSO. -->
                    <StackPanel x:Name="MySotaField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowMySotaField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MY SOTA" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding MySotaIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding MySotaRef, Mode=TwoWay}" Tag="W6/CT-003"/>
                        <TextBlock Text="Format looks off (expects e.g. W6/CT-003)" FontSize="10" Foreground="#e67e22"
                                  FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowMySotaRefWarning}"/>
                    </StackPanel>

                    <!-- SOTA: per-QSO, same warning-label rationale as My SOTA above. The field is
                         narrowed and an inline "update reference database" button sits beside it (same
                         field-plus-buttons layout as Seq # below) rather than a separate sidebar button,
                         so the update trigger sits right next to the field it actually affects; together
                         they still fill the same width the field alone used to. -->
                    <StackPanel x:Name="SotaField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowSotaField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="SOTA" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <!-- Grid, not a horizontal StackPanel: see the SKCC field above for why. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                    Text="{Binding SotaRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="W6/CT-003"/>
                            <Button Grid.Column="1" Content="⟳" Command="{Binding UpdateSotaDbCommand}" FontSize="16"
                                   ToolTip="Update the local SOTA reference database" Width="34" Padding="0"
                                   Background="#3498db" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
                        </Grid>
                        <TextBlock Text="Format looks off (expects e.g. W6/CT-003)" FontSize="10" Foreground="#e67e22"
                                  FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowSotaRefWarning}"/>
                        <!-- Resolved summit name/detail from the local SOTA reference database (see
                             QsoEntryViewModel.ResolveSotaRefAsync); same slot as the warning above, the
                             two never show at once. -->
                        <TextBlock Text="{Binding SotaLookupText}" FontSize="10" Foreground="#2980b9"
                                  Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowSotaLookupText}"/>
                    </StackPanel>

                    <!-- My POTA (bound to MySigInfo): sticky, same rationale as My SOTA above. -->
                    <StackPanel x:Name="MyPotaField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowMyPotaField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MY POTA" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <CheckBox Content="static" IsTabStop="False" FontSize="10" Foreground="#999999" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                     IsChecked="{Binding MyPotaIsStatic, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding MySigInfo, Mode=TwoWay}" Tag="K-0001"/>
                        <TextBlock Text="Format looks off (expects e.g. K-0001)" FontSize="10" Foreground="#e67e22"
                                  FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowMySigInfoWarning}"/>
                    </StackPanel>

                    <!-- POTA (bound to SigInfo): per-QSO, same warning-label rationale as My POTA above.
                         Same narrowed-field-plus-button layout as SOTA above. -->
                    <StackPanel x:Name="PotaField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowPotaField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="POTA" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <!-- Grid, not a horizontal StackPanel: see the SKCC field above for why. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                    Text="{Binding SigInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="K-0001"/>
                            <Button Grid.Column="1" Content="⟳" Command="{Binding UpdatePotaDbCommand}" FontSize="16"
                                   ToolTip="Update the local POTA reference database" Width="34" Padding="0"
                                   Background="#3498db" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
                        </Grid>
                        <TextBlock Text="Format looks off (expects e.g. K-0001)" FontSize="10" Foreground="#e67e22"
                                  FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowSigInfoWarning}"/>
                        <!-- Resolved park name/detail from the local POTA reference database (see
                             QsoEntryViewModel.ResolvePotaRefAsync); same slot as the warning above, the
                             two never show at once. -->
                        <TextBlock Text="{Binding PotaLookupText}" FontSize="10" Foreground="#2980b9"
                                  Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ShowPotaLookupText}"/>
                    </StackPanel>

                    <!-- Seq #: read-only counter, Start arms it at 1 and enables auto-increment on each
                         logged QSO, Reset disarms it back to "—" (see QsoEntryViewModel.StartSequence/
                         ResetSequence). -->
                    <StackPanel x:Name="SequenceField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowSequenceField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="SEQ #" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <!-- Grid, not a horizontal StackPanel: see the SKCC field above for why. The
                             counter takes the leftover width; both buttons stay their natural size. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" MinWidth="50">
                                <TextBlock Text="{Binding SequenceNumberText}" FontSize="14" HorizontalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="Start" Command="{Binding StartSequenceCommand}" ToolTip="Start the running QSO sequence number at 1"
                                   Background="#2E7D32" Foreground="White"
                                   Padding="10,10" FontSize="12" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Reset" Command="{Binding ResetSequenceCommand}" ToolTip="Stop and clear the sequence number"
                                   Background="#c0392b" Foreground="White"
                                   Padding="10,10" FontSize="12" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>

                    <!-- QSL Via -->
                    <StackPanel x:Name="QslViaField" Style="{StaticResource FieldBox}" Visibility="{Binding ShowQslViaField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="QSL VIA" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QslViaCallsign, Mode=TwoWay}" Tag="W1AW"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
