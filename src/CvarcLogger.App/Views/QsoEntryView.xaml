<UserControl x:Class="CvarcLogger.App.Views.QsoEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Fixed width per field, shared by every row via this one style: a hidden field
             (Visibility=Collapsed) takes zero space in a WrapPanel, so the remaining visible fields
             naturally pack left/up to fill the gap instead of leaving a blank hole. -->
        <Style x:Key="FieldBox" TargetType="StackPanel">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Form Title -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
            <TextBlock Text="Entry Form - Normal Mode (Fields are movable within tabs)"
                      FontSize="16" FontWeight="Bold" Foreground="#000000"/>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <!-- Row 1 -->
                <WrapPanel Orientation="Horizontal">
                    <!-- Station -->
                    <StackPanel Style="{StaticResource FieldBox}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="STATION" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 SelectedValuePath="Callsign" ItemsSource="{Binding AvailableStationProfiles}"
                                 SelectedItem="{Binding SelectedStationProfile, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Callsign}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Callsign -->
                    <StackPanel Style="{StaticResource FieldBox}">
                        <TextBlock Text="CALLSIGN" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Callsign, Mode=TwoWay}" Tag="W5XYZ"/>
                    </StackPanel>

                    <!-- Date/Time UTC -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowUtcTimeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="DATE/TIME UTC" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoDateTimeUtcText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <!-- Band -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowBandField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="BAND" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding Bands}" Text="{Binding Band, Mode=TwoWay}"
                                 IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- Freq -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowFreqField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="FREQ (MHZ)" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding FrequencyMhz, Mode=TwoWay}" Tag="14.200"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Row 2 -->
                <WrapPanel Orientation="Horizontal">
                    <!-- Mode -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowModeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="MODE" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding Modes}" Text="{Binding Mode, Mode=TwoWay}"
                                 IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- Sub-Mode -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowSubModeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="SUB-MODE" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ComboBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                 ItemsSource="{Binding SubModes}" Text="{Binding SubMode, Mode=TwoWay}"
                                 IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- Local Time -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowLocalTimeField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="LOCAL TIME" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoDateTimeLocalText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                </WrapPanel>

                <!-- Row 3 (continues Row 2's overflow: max 5 fields per row) -->
                <WrapPanel Orientation="Horizontal">
                    <!-- Time Off -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowTimeOffField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="TIME OFF (UTC)" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding QsoDateTimeOffUtcText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <!-- RST Sent -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowRstField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="RST SENT" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding RstSent, Mode=TwoWay}" Tag="599"/>
                    </StackPanel>

                    <!-- RST Rcvd -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowRstField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="RST RCVD" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding RstRcvd, Mode=TwoWay}" Tag="599"/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowNameField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="NAME" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Name, Mode=TwoWay}" Tag="John"/>
                    </StackPanel>

                    <!-- Grid -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowGridField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="GRID" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding GridSquare, Mode=TwoWay}" Tag="DN70"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Row 4 -->
                <WrapPanel Orientation="Horizontal">
                    <!-- City -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowCityField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CITY" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding City, Mode=TwoWay}" Tag="Dallas"/>
                    </StackPanel>

                    <!-- State -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowStateField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="STATE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding State, Mode=TwoWay}" Tag="TX"/>
                    </StackPanel>

                    <!-- County -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowCountyField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="COUNTY" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding County, Mode=TwoWay}" Tag="Dallas County"/>
                    </StackPanel>

                    <!-- Country -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowCountryField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="COUNTRY" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Country, Mode=TwoWay}" Tag="USA"/>
                    </StackPanel>

                    <!-- ARRL Section -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowArrlSectionField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ARRL SECTION" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding ArrlSection, Mode=TwoWay}" Tag="NTX"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Row 5 -->
                <WrapPanel Orientation="Horizontal">
                    <!-- CQ Zone -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowCqZoneField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CQ ZONE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding CqZone, Mode=TwoWay}" Tag="5"/>
                    </StackPanel>

                    <!-- ITU Zone -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowItuZoneField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ITU ZONE" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding ItuZone, Mode=TwoWay}" Tag="27"/>
                    </StackPanel>

                    <!-- Comment -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowCommentField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="COMMENT" FontSize="12" FontWeight="Bold" Foreground="#555555"
                                  Margin="0,0,0,5"/>
                        <TextBox Background="White" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Comment, Mode=TwoWay}" Tag="Strong signal"/>
                    </StackPanel>

                    <!-- Operator -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowOpField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="OP" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding Op, Mode=TwoWay}" Tag="W5ABC"/>
                    </StackPanel>

                    <!-- TX Power -->
                    <StackPanel Style="{StaticResource FieldBox}" Visibility="{Binding ShowTxPowerField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="TX(W)" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text=" (static)" FontSize="10" Foreground="#999999" FontStyle="Italic" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox Background="#ecf0f1" BorderBrush="#555555" BorderThickness="1" Padding="10" FontSize="14"
                                Text="{Binding TxPowerWatts, Mode=TwoWay}" Tag="100"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="Lookup" Background="#3498db" Foreground="White"
                           Padding="24,12" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"
                           Click="LookupButton_Click" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Log QSO" Background="#2E7D32" Foreground="White"
                           Padding="24,12" FontSize="14" FontWeight="SemiBold"
                           Click="LogButton_Click" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
