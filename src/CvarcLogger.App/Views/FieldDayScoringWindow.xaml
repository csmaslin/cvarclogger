<Window x:Class="CvarcLogger.App.Views.FieldDayScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Field Day Scoring" Height="720" Width="700"
        Background="White" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
            <emoji:TextBlock Text="📻 ARRL Field Day Scoring" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
        </Border>

        <!-- Inputs row: year, power class, bonuses -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="YEAR" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="YearBox" Padding="6" FontSize="14" Width="80" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                <TextBlock Text="POWER CLASS" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="PowerClassBox" Padding="6" FontSize="14" Width="200">
                    <ComboBoxItem Content="QRP Battery (≤5W) — ×5" Tag="QrpBattery"/>
                    <ComboBoxItem Content="Low Power (≤150W) — ×2" Tag="LowPower" IsSelected="True"/>
                    <ComboBoxItem Content="High Power (&gt;150W) — ×1" Tag="HighPower"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,20,0">
                <TextBlock Text="BONUS POINTS" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="BonusBox" Padding="6" FontSize="14" Width="100" Text="0"/>
            </StackPanel>

            <CheckBox Grid.Column="4" x:Name="StrictContestIdBox" Content="Require ContestId=ARRL-FIELD-DAY"
                      VerticalAlignment="Center" IsChecked="False"
                      ToolTip="When off, all QSOs inside the FD weekend window count."/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Content="Recalculate" Padding="16,8" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Click="Recalculate_Click"/>
        </StackPanel>

        <!-- Score breakdown -->
        <Border Grid.Row="2" BorderBrush="#dddddd" BorderThickness="1" CornerRadius="4" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel">
                    <TextBlock Text="Enter a year and click Recalculate to score."
                               Foreground="#666666" FontStyle="Italic"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Close" Padding="20,10" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
