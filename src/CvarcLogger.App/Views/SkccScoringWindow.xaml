<Window x:Class="CvarcLogger.App.Views.SkccScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:behaviors="clr-namespace:CvarcLogger.App.Behaviors"
        Title="SKCC Scoring" Icon="/Assets/AppIcon.ico"
        Height="800" Width="1100" MinHeight="600" MinWidth="900"
        Background="#f5f5f5" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
        </Style>
        <Style x:Key="StandardInput" TargetType="Control">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#dddddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left dark rail -->
        <Border Grid.Column="0" Background="#404040">
            <StackPanel Margin="16,20,16,16">
                <emoji:TextBlock Text="🔑" FontSize="42" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,6"/>
                <TextBlock Text="SKCC" FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Event scoring" FontSize="11" Foreground="#bdc3c7"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right content with tabs -->
        <TabControl Grid.Column="1">
            <!-- Score Tab -->
            <TabItem Header="Score" Padding="12,6">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
                        <TextBlock Text="Score Sheet" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
                    </Border>

                    <!-- Inputs card -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="EVENT" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EventTypeBox" Style="{StaticResource StandardInput}" Width="220"
                                              SelectionChanged="EventTypeBox_SelectionChanged">
                                        <ComboBoxItem Content="Weekday Sprint (SKS)" Tag="WeekdaySprint" IsSelected="True"/>
                                        <ComboBoxItem Content="Weekend Sprintathon (WES)" Tag="WeekendSprintathon"/>
                                        <ComboBoxItem Content="Europe Sprint (SKSE)" Tag="EuropeSprint"/>
                                        <ComboBoxItem Content="Asia Sprint (SKSA)" Tag="AsiaSprint"/>
                                        <ComboBoxItem Content="QSO Party" Tag="QsoParty"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                    <TextBlock Text="EVENT START (UTC)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="StartUtcBox" Style="{StaticResource StandardInput}" Width="160"
                                             behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"
                                             ToolTip="Leave blank to include every logged QSO with no start cutoff"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                                    <TextBlock Text="EVENT END (UTC)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EndUtcBox" Style="{StaticResource StandardInput}" Width="160"
                                             behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"
                                             ToolTip="Leave blank to include every logged QSO with no end cutoff"/>
                                </StackPanel>
                            </Grid>

                            <!-- Manual inputs for the two bonuses that aren't derivable from the log itself. -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="SpecialMemberPanel" Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="SPECIAL MEMBER CALLSIGN (this sprint's designated station, if any)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SpecialMemberBox" Style="{StaticResource StandardInput}" Width="220"
                                             ToolTip="SKS names a different 'Designated Special SKCC Member' each sprint -- enter that callsign to score the +25/band bonus for contacting it"/>
                                </StackPanel>

                                <CheckBox x:Name="SoapboxPhotoBox" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                          Content="Photo/soapbox submitted (+100 pts)"
                                          ToolTip="QSO Party only -- this is a manual submission choice, not something derivable from the log"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Score breakdown -->
                    <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#e0e0e0"
                                    Padding="0,0,0,8" Margin="0,0,0,10">
                                <emoji:TextBlock Text="🧮 Score Breakdown" FontSize="14" FontWeight="Bold" Foreground="#000000"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ResultsPanel">
                                    <TextBlock Text="Pick an event, set the start/end window if needed, then click Recalculate."
                                               Foreground="#666666" FontStyle="Italic"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Recalculate" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Recalculate_Click"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Multiplier & Bonus Details Tab -->
            <TabItem Header="Multiplier &amp; Bonus Details" Padding="12,6">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
                        <TextBlock Text="Multiplier &amp; Bonus Details" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Unique SPCs Worked (multipliers)" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="MultiplierGrid" DockPanel.Dock="Top" AutoGenerateColumns="False" IsReadOnly="True"
                                          AlternationCount="2" AlternatingRowBackground="WhiteSmoke" ColumnHeaderHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="State/Province/Country" Binding="{Binding Spc}" Width="*"/>
                                        <DataGridTextColumn Header="QSOs" Binding="{Binding QsoCount}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Member Tier Bonuses" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="TierBonusGrid" DockPanel.Dock="Top" AutoGenerateColumns="False" IsReadOnly="True"
                                          AlternationCount="2" AlternatingRowBackground="WhiteSmoke" ColumnHeaderHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}" Width="*"/>
                                        <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="50"/>
                                        <DataGridTextColumn Header="Bonus" Binding="{Binding Points}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,15,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Other Bonuses (KS1KCC, grid squares, /BD stations, manual)" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DataGrid x:Name="ExtraBonusGrid" DockPanel.Dock="Top" AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="220" AlternationCount="2" AlternatingRowBackground="WhiteSmoke" ColumnHeaderHeight="28">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
