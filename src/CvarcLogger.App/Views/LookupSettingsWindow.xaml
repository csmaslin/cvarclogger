<Window x:Class="CvarcLogger.App.Views.LookupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:behaviors="clr-namespace:CvarcLogger.App.Behaviors"
        mc:Ignorable="d"
        Title="Lookup" Icon="/Assets/AppIcon.ico" FontSize="14"
        Height="900" Width="950" MinHeight="700" MinWidth="800"
        Background="White"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modal Title -->
        <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,20">
            <emoji:TextBlock Text="🔍 Lookup Sources" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">
                    <Border BorderThickness="0,0,0,1" BorderBrush="#dddddd" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="CALLSIGN LOOKUP" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Description}"
                               Text="Checked in order: QRZ.com, QRZCQ.com, then Callook.info — each is skipped if not configured."/>

                    <Border BorderThickness="0,0,0,1" BorderBrush="#dddddd" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="QRZ.COM XML DATA API" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Description}"
                               Text="Requires a paid QRZ XML Data subscription. Credentials stored encrypted on this machine only."/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding QrzUsername, UpdateSourceTrigger=PropertyChanged}" Tag="Your QRZ username" Padding="8" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="QrzPasswordBox" behaviors:PasswordBoxHelper.Placeholder="Your QRZ password" Padding="8" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="QrzPasswordTextBox" Tag="Your QRZ password" Padding="8" FontSize="14" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <CheckBox x:Name="QrzShowPasswordCheckBox" Content="Show password" FontSize="13" Foreground="#000000"
                              Margin="0,0,0,10"
                              Checked="QrzShowPassword_Checked" Unchecked="QrzShowPassword_Unchecked"/>

                    <Border Background="#f9f9f9" CornerRadius="3" Padding="8" Margin="0,0,0,12">
                        <TextBlock FontStyle="Italic" Foreground="#666666" FontSize="12">
                            <Run Text="Status: "/>
                            <Run Text="{Binding QrzStatusText, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Click="SaveCredentials_Click" ToolTip="Save QRZ.com credentials" Padding="14,10"
                                Background="#2E7D32" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                            <emoji:TextBlock Text="💾 Save" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Click="TestQrzConnection_Click" ToolTip="Test the QRZ.com connection" Padding="14,10"
                                Background="#3498db" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                            <emoji:TextBlock Text="🧪 Test" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Content="Clear" Command="{Binding ClearQrzCredentialsCommand}" Click="ClearQrzPasswordBox_Click" ToolTip="Clear saved QRZ.com credentials" Padding="14,10"
                                Background="#3498db" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2">
                    <Border BorderThickness="0,0,0,1" BorderBrush="#dddddd" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="QRZCQ.COM XML API" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Description}"
                               Text="Requires a Premium QRZCQ account. Credentials stored encrypted on this machine only."/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding QrzCqUsername, UpdateSourceTrigger=PropertyChanged}" Tag="Your QRZCQ username" Padding="8" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="QrzCqPasswordBox" behaviors:PasswordBoxHelper.Placeholder="Your QRZCQ password" Padding="8" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="QrzCqPasswordTextBox" Tag="Your QRZCQ password" Padding="8" FontSize="14" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <CheckBox x:Name="QrzCqShowPasswordCheckBox" Content="Show password" FontSize="13" Foreground="#000000"
                              Margin="0,0,0,10"
                              Checked="QrzCqShowPassword_Checked" Unchecked="QrzCqShowPassword_Unchecked"/>

                    <Border Background="#f9f9f9" CornerRadius="3" Padding="8" Margin="0,0,0,12">
                        <TextBlock FontStyle="Italic" Foreground="#666666" FontSize="12">
                            <Run Text="Status: "/>
                            <Run Text="{Binding QrzCqStatusText, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Click="SaveQrzCqCredentials_Click" ToolTip="Save QRZCQ.com credentials" Padding="14,10"
                                Background="#2E7D32" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                            <emoji:TextBlock Text="💾 Save" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Click="TestQrzCqConnection_Click" ToolTip="Test the QRZCQ.com connection" Padding="14,10"
                                Background="#3498db" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                            <emoji:TextBlock Text="🧪 Test" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Content="Clear" Command="{Binding ClearQrzCqCredentialsCommand}" Click="ClearQrzCqPasswordBox_Click" ToolTip="Clear saved QRZCQ.com credentials" Padding="14,10"
                                Background="#3498db" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border BorderThickness="0,0,0,1" BorderBrush="#dddddd" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="GRIDTRACKER2" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Description}"
                               Text="Broadcasts logged QSOs over UDP so GridTracker2 can plot them in real time."/>

                    <CheckBox Content="Enable GridTracker2 broadcast" IsChecked="{Binding GridTrackerEnabled}"
                              FontSize="13" Foreground="#000000" Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Margin="0,0,10,0" Width="200">
                            <TextBlock Text="HOST" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding GridTrackerHost, UpdateSourceTrigger=PropertyChanged}" Tag="127.0.0.1" Padding="8" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Width="100">
                            <TextBlock Text="PORT" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding GridTrackerPort, UpdateSourceTrigger=PropertyChanged}" Tag="2240" Padding="8" FontSize="14"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Command="{Binding SaveGridTrackerSettingsCommand}" ToolTip="Save GridTracker2 broadcast settings" Padding="14,10"
                                Background="#2E7D32" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                            <emoji:TextBlock Text="💾 Save" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding SendGridTrackerTestPacketCommand}" ToolTip="Send a test UDP packet to GridTracker2" Padding="14,10"
                                Background="#3498db" Foreground="White" BorderThickness="0">
                            <emoji:TextBlock Text="🧪 Test" FontSize="13" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <Border BorderThickness="0,0,0,1" BorderBrush="#dddddd" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="WSJT-X" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Description}"
                               Text="Receives WSJT-X data via UDP through the port selected below."/>

                    <CheckBox Content="Enable WSJT-X log receiving" IsChecked="{Binding WsjtxEnabled}"
                              FontSize="13" Foreground="#000000" Margin="0,0,0,12"/>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="UDP PORT" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding WsjtxPort, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left" Width="100" Padding="8" FontSize="14"/>
                        <TextBlock FontSize="11" Foreground="#999999" Margin="0,4,0,0"
                                   Text="GridTracker2 relay: 2238, WSJT-X multicast: 2237"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
