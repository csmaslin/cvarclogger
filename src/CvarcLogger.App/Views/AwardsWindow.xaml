<Window x:Class="CvarcLogger.App.Views.AwardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:CvarcLogger.App.Converters"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="Awards Progress" Icon="/Assets/AppIcon.ico" Height="820" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" ResizeMode="CanResize" Loaded="Window_Loaded">
    <Window.Resources>
        <conv:PointsDisplayConverter x:Key="PointsDisplayConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Left-side tab styled as a sidebar button: dark background, wide, left-aligned, no default
             tab chrome. Selected state lights up in the app's accent blue like the main sidebar. -->
        <Style x:Key="SidebarTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="4,0,0,0"
                                Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#34495e"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabControl" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Background" Value="#f5f5f5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Dark sidebar hosting the vertical tab strip. -->
                            <Border Grid.Column="0" Background="#404040" MinWidth="200">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,20">
                                        <TextBlock Text="🏅" FontSize="42" HorizontalAlignment="Center"
                                                   Foreground="White" Margin="0,0,0,6"/>
                                        <TextBlock Text="Awards" FontSize="18" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Progress tracker" FontSize="11" Foreground="#bdc3c7"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True"
                                              Background="#404040"/>
                                </DockPanel>
                            </Border>
                            <!-- Content area for the selected tab. -->
                            <Border Grid.Column="1" Background="#f5f5f5" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0"
                                            Padding="0,0,0,10" Margin="0,0,0,15">
                                        <TextBlock Text="Awards Progress" FontSize="18" FontWeight="Bold"
                                                   Foreground="#000000"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Margin="0,0,0,15" FontSize="12" Foreground="#666666"
                                               TextWrapping="Wrap"
                                               Text="DXCC entity resolution uses a bundled, community-assembled approximation of the ARRL DXCC prefix list, not the official ARRL data. Correct any misattributed entity from the QSO log directly; totals here update automatically."/>
                                    <Border Grid.Row="2" Background="White" BorderBrush="#dddddd"
                                            BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                                          ContentSource="SelectedContent" Margin="12"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarTabItem}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Style="{StaticResource SidebarTabControl}">
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="🌐  DXCC" FontSize="14"/>
                </TabItem.Header>
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Band:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox DockPanel.Dock="Left" Width="100" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Dxcc.Bands}" SelectedItem="{Binding Dxcc.SelectedBand}"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#C0392B"
                               Text="{Binding Dxcc.ErrorMessage}"
                               Visibility="{Binding Dxcc.HasErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" FontWeight="Bold">
                        <Run Text="Worked: "/>
                        <Run Text="{Binding Dxcc.Progress.WorkedCount, Mode=OneWay}"/>
                        <Run Text="   Confirmed: "/>
                        <Run Text="{Binding Dxcc.Progress.ConfirmedCount, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" Foreground="Gray">
                        <Run Text="QSOs per Band:"/>
                    </TextBlock>
                    <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,10" ItemsSource="{Binding Dxcc.BandCounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,0,16,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Band}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding QsoCount}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" Foreground="Gray">
                        <Run Text="5-Band DXCC (100+ confirmed entities on each band):"/>
                    </TextBlock>
                    <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,10" ItemsSource="{Binding Dxcc.FiveBandProgress}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,0,16,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Band}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ConfirmedCount}" FontSize="11" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Qualifies}" Value="True">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding Dxcc.EntityRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternationCount="2" AlternatingRowBackground="WhiteSmoke">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Worked" Binding="{Binding Worked}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Phone" Binding="{Binding Phone}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="CW" Binding="{Binding Cw}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Digital" Binding="{Binding Digital}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="🇺🇸  WAS" FontSize="14"/>
                </TabItem.Header>
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" FontWeight="Bold">
                        <Run Text="Worked: "/>
                        <Run Text="{Binding WasProgress.WorkedCount, Mode=OneWay}"/>
                        <Run Text=" / 50   Confirmed: "/>
                        <Run Text="{Binding WasProgress.ConfirmedCount, Mode=OneWay}"/>
                        <Run Text=" / 50"/>
                    </TextBlock>

                    <!-- Same all-QSO per-band totals as the DXCC tab's strip; reuses Dxcc.BandCounts
                         directly (already loaded by AwardsViewModel.LoadAsync) rather than fetching it a
                         second time, since it isn't filtered to WAS-eligible QSOs and so is identical
                         data regardless of which tab shows it. -->
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" Foreground="Gray">
                        <Run Text="QSOs per Band:"/>
                    </TextBlock>
                    <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,10" ItemsSource="{Binding Dxcc.BandCounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,0,16,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Band}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding QsoCount}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding WasProgress.States}" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternationCount="2" AlternatingRowBackground="WhiteSmoke">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Worked" Binding="{Binding Worked}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Phone" Binding="{Binding Phone}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="CW" Binding="{Binding Cw}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Digital" Binding="{Binding Digital}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="⛰️  SOTA" FontSize="14"/>
                </TabItem.Header>
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold">
                        <Run Text="Activated: "/>
                        <Run Text="{Binding MountainGoat.TotalPoints, Mode=OneWay}"/>
                        <Run Text=" / 1000 points toward Mountain Goat"/>
                    </TextBlock>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Summit Code:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="Refresh Summit List" Padding="12,4" Margin="6,0,0,0"
                                Command="{Binding MountainGoat.RefreshListCommand}"
                                ToolTip="Force-downloads the official SOTA summit list now, instead of waiting for its normal 30-day refresh."/>
                        <Button DockPanel.Dock="Right" Content="Add" Padding="12,4" Margin="6,0,0,0"
                                Command="{Binding MountainGoat.AddSummitCommand}" ToolTip="Add this summit to your activation list"/>
                        <TextBox Width="160" HorizontalAlignment="Left" CharacterCasing="Upper"
                                 Text="{Binding MountainGoat.NewSummitCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <Button DockPanel.Dock="Bottom" Content="Delete Selected" Padding="10,2" Margin="0,8,0,0"
                            HorizontalAlignment="Left" ToolTip="Remove the selected summit from this list"
                            Command="{Binding MountainGoat.DeleteCommand}"
                            CommandParameter="{Binding ElementName=MountainGoatGrid, Path=SelectedItem}"/>

                    <DataGrid x:Name="MountainGoatGrid" ItemsSource="{Binding MountainGoat.Activations}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              AlternationCount="2" AlternatingRowBackground="WhiteSmoke"
                              CellEditEnding="MountainGoatGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Summit Code" Binding="{Binding SummitCode}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Points" Width="Auto" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <!-- Shows the point value in parentheses, e.g. "(4)", until Activated is
                                         checked, so an in-progress summit shows what it would be worth once the
                                         4-contact activation rule is actually met. -->
                                    <MultiBinding Converter="{StaticResource PointsDisplayConverter}">
                                        <Binding Path="Points"/>
                                        <Binding Path="Activated"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Activated" Binding="{Binding Activated}" Width="Auto"/>
                            <DataGridTextColumn Header="Activation Date/Time" Binding="{Binding ActivationDateUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto"/>
                            <DataGridTextColumn Header="Summit Name" Binding="{Binding SummitName}" Width="Auto" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="🌳  POTA" FontSize="14"/>
                </TabItem.Header>
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold">
                        <Run Text="Activated: "/>
                        <Run Text="{Binding ParksOnTheAir.TotalParksActivated, Mode=OneWay}"/>
                        <Run Text=" parks   Award: "/>
                        <Run Text="{Binding ParksOnTheAir.CurrentAwardTier, Mode=OneWay}"/>
                        <Run Text="   Kilo Parks (1,000+ QSOs): "/>
                        <Run Text="{Binding ParksOnTheAir.KiloParkCount, Mode=OneWay}"/>
                    </TextBlock>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Park Reference:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="Refresh Park Info" Padding="12,4" Margin="6,0,0,0"
                                Command="{Binding ParksOnTheAir.RefreshCommand}"
                                ToolTip="Re-checks live park names for everything in this list from POTA's API. POTA has no single bulk export, so this only re-checks parks you're already tracking, not the full worldwide list."/>
                        <Button DockPanel.Dock="Right" Content="Add" Padding="12,4" Margin="6,0,0,0"
                                Command="{Binding ParksOnTheAir.AddParkCommand}" ToolTip="Add this park to your activation list"/>
                        <TextBox Width="160" HorizontalAlignment="Left" CharacterCasing="Upper"
                                 Text="{Binding ParksOnTheAir.NewParkReference, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <Button DockPanel.Dock="Bottom" Content="Delete Selected" Padding="10,2" Margin="0,8,0,0"
                            HorizontalAlignment="Left" ToolTip="Remove the selected park from this list"
                            Command="{Binding ParksOnTheAir.DeleteCommand}"
                            CommandParameter="{Binding ElementName=PotaGrid, Path=SelectedItem}"/>

                    <DataGrid x:Name="PotaGrid" ItemsSource="{Binding ParksOnTheAir.Activations}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              AlternationCount="2" AlternatingRowBackground="WhiteSmoke"
                              CellEditEnding="PotaGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Park Reference" Binding="{Binding ParkReference}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Park Name" Binding="{Binding ParkName}" Width="Auto" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Activated" Binding="{Binding Activated}" Width="Auto"/>
                            <DataGridTextColumn Header="Activation Date/Time" Binding="{Binding ActivationDateUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto"/>
                            <DataGridTextColumn Header="Total QSOs" Binding="{Binding TotalQsoCount}" Width="Auto" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Kilo" Binding="{Binding IsKiloEligible, Mode=OneWay}" Width="Auto" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <emoji:TextBlock Text="🔑  SKCC" FontSize="14"/>
                </TabItem.Header>
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="Best-effort estimate, not the official submission tool: counts any CW QSO with an SKCC # logged, trusting it was made with a manual key (straight key/bug/cootie) as SKCC requires -- CvarcLogger has no field to verify that."/>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#C0392B"
                               Text="{Binding Skcc.ErrorMessage}"
                               Visibility="{Binding Skcc.HasErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button DockPanel.Dock="Top" Content="Update SKCC Award Lists" Padding="12,4" Margin="0,0,0,10"
                            HorizontalAlignment="Left" Command="{Binding Skcc.UpdateAwardListsCommand}"
                            ToolTip="Downloads the official Centurion/Tribune/Senator award lists so Tribune/Senator eligibility can be checked offline"/>

                    <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,10" ItemsSource="{Binding Skcc.Tiers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,0,28,0">
                                    <TextBlock Text="{Binding TierName}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding Display}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Achieved}" Value="True">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Note}" FontSize="10" Foreground="Gray" FontStyle="Italic"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding Skcc.Members}" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternationCount="2" AlternatingRowBackground="WhiteSmoke">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKCC #" Binding="{Binding SkccNr}" Width="Auto"/>
                            <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}" Width="Auto"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto"/>
                            <DataGridTextColumn Header="QSO Date (UTC)" Binding="{Binding QsoDateUtc, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Centurion" Binding="{Binding CountsForCenturion}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Tribune" Binding="{Binding CountsForTribune}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Senator" Binding="{Binding CountsForSenator}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
