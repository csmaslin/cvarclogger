<Window x:Class="CvarcLogger.App.Views.AwardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Awards Progress" Height="600" Width="700" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                   Text="DXCC entity resolution uses a bundled, community-assembled approximation of the ARRL DXCC prefix list, not the official ARRL data. Correct any misattributed entity from the QSO log directly; totals here update automatically."/>

        <TabControl Grid.Row="1">
            <TabItem Header="DXCC">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold">
                        <Run Text="Worked: "/>
                        <Run Text="{Binding DxccProgress.WorkedCount, Mode=OneWay}"/>
                        <Run Text="   Confirmed: "/>
                        <Run Text="{Binding DxccProgress.ConfirmedCount, Mode=OneWay}"/>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding DxccProgress.Entities}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Worked" Binding="{Binding Worked}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="WAS (Worked All States)">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold">
                        <Run Text="Worked: "/>
                        <Run Text="{Binding WasProgress.WorkedCount, Mode=OneWay}"/>
                        <Run Text=" / 50   Confirmed: "/>
                        <Run Text="{Binding WasProgress.ConfirmedCount, Mode=OneWay}"/>
                        <Run Text=" / 50"/>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding WasProgress.States}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Worked" Binding="{Binding Worked}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
