<Window x:Class="CvarcLogger.App.Views.FileOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="File Operations" Width="700"
        Background="White" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" SizeToContent="Height">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="30">
            <Border BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,10">
                <TextBlock Text="File Operations" FontSize="18" FontWeight="Bold"
                          Foreground="#000000"/>
            </Border>

            <!-- Log Files Section -->
            <StackPanel Orientation="Vertical" Margin="0,25,0,0">
                <Border BorderThickness="0,0,0,1" BorderBrush="#ddd" Padding="0,0,0,8">
                    <emoji:TextBlock Text="📁 LOG FILES" FontSize="14" FontWeight="Bold" Foreground="#000000"/>
                </Border>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Create a new, empty log database"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="NewLog_Click">
                    <emoji:TextBlock Text="📄 New Log..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Open an existing log database file"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="OpenLog_Click">
                    <emoji:TextBlock Text="🗂️ Open Log..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Save a copy of the current log database"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="SaveLog_Click">
                    <emoji:TextBlock Text="💾 Save Log..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
            </StackPanel>

            <!-- Import/Export Section -->
            <StackPanel Orientation="Vertical" Margin="0,25,0,0">
                <Border BorderThickness="0,0,0,1" BorderBrush="#ddd" Padding="0,0,0,8">
                    <emoji:TextBlock Text="📨 IMPORT/EXPORT" FontSize="14" FontWeight="Bold" Foreground="#000000"/>
                </Border>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Import QSOs from an ADIF file"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="ImportADIF_Click">
                    <emoji:TextBlock Text="📥 Import ADIF..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Export QSOs to an ADIF file"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="ExportADIF_Click">
                    <emoji:TextBlock Text="📤 Export ADIF..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Import QSOs from a Cabrillo contest log"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="ImportCabrillo_Click">
                    <emoji:TextBlock Text="📥 Import Cabrillo..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
                <Button Padding="12,16" Foreground="#2c2c2c" ToolTip="Export QSOs as a Cabrillo contest log"
                       Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Click="ExportCabrillo_Click">
                    <emoji:TextBlock Text="📤 Export Cabrillo..." FontSize="14" Foreground="#2c2c2c"/>
                </Button>
            </StackPanel>

            <!-- Close Button -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                <Button Content="Close" Padding="10,12,24,12" Margin="10,0" ToolTip="Close this window"
                       Background="#2E7D32" Foreground="White"
                       Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
