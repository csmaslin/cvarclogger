<Window x:Class="CvarcLogger.App.Views.FileOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="File Operations" Width="900" Height="700"
        Background="#f5f5f5" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left dark rail -->
        <Border Grid.Column="0" Background="#404040">
            <StackPanel Margin="16,20,16,16">
                <emoji:TextBlock Text="📁" FontSize="42" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,6"/>
                <TextBlock Text="File Operations" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Import/Export" FontSize="11" Foreground="#bdc3c7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
                <TextBlock Text="File Operations" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
            </Border>

            <!-- Scrollable content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!-- Log Files Section -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="#e0e0e0" Padding="0,0,0,8" Margin="0,0,0,15">
                        <TextBlock Text="LOG FILES" FontSize="13" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Create a new, empty log database"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Click="NewLog_Click">
                        <emoji:TextBlock Text="📄 New Log..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Open an existing log database file"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Click="OpenLog_Click">
                        <emoji:TextBlock Text="🗂️ Open Log..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Save a copy of the current log database"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,24"
                           Click="SaveLog_Click">
                        <emoji:TextBlock Text="💾 Save Log..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>

                    <!-- ADIF Section -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="#e0e0e0" Padding="0,0,0,8" Margin="0,0,0,15">
                        <TextBlock Text="ADIF FORMAT" FontSize="13" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Import QSOs from an ADIF file"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Click="ImportADIF_Click">
                        <emoji:TextBlock Text="📥 Import ADIF..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Export QSOs to an ADIF file"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,24"
                           Click="ExportADIF_Click">
                        <emoji:TextBlock Text="📤 Export ADIF..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>

                    <!-- Cabrillo Section -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="#e0e0e0" Padding="0,0,0,8" Margin="0,0,0,15">
                        <TextBlock Text="CABRILLO FORMAT" FontSize="13" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Import QSOs from a Cabrillo contest log"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Click="ImportCabrillo_Click">
                        <emoji:TextBlock Text="📥 Import Cabrillo..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Export QSOs as a Cabrillo contest log"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,24"
                           Click="ExportCabrillo_Click">
                        <emoji:TextBlock Text="📤 Export Cabrillo..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>

                    <!-- CSV Section -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="#e0e0e0" Padding="0,0,0,8" Margin="0,0,0,15">
                        <TextBlock Text="CSV FORMAT" FontSize="13" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Import QSOs from a CSV file"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Click="ImportCSV_Click">
                        <emoji:TextBlock Text="📥 Import CSV..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>
                    <Button Padding="12,12" Foreground="#2c2c2c" ToolTip="Export QSOs to a CSV file"
                           Background="White" BorderBrush="#dddddd" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Click="ExportCSV_Click">
                        <emoji:TextBlock Text="📤 Export CSV..." FontSize="14" Foreground="#2c2c2c"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Close Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Close" Padding="20,10" ToolTip="Close this window"
                       Background="#3498db" Foreground="White" BorderThickness="0"
                       Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Busy overlay: shown during import/export/save/load so the user sees the app is working. -->
        <Border x:Name="BusyOverlay" Background="#B3000000" Visibility="Collapsed" Grid.ColumnSpan="2">
            <Border Background="White" CornerRadius="6" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#cccccc" BorderThickness="1">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="14" Margin="0,0,0,15"/>
                    <TextBlock x:Name="BusyMessage" Text="Working..." FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#000000"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
