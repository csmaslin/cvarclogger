<Window x:Class="CvarcLogger.App.Views.NaqpScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="NAQP Scoring" Icon="/Assets/AppIcon.ico"
        Height="900" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MetricGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#404040" Padding="24,16">
            <StackPanel>
                <emoji:TextBlock Text="🌐" FontSize="32" Foreground="White"/>
                <TextBlock Text="NAQP" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                <TextBlock Text="North American QSO Party: CW, SSB, RTTY, each run twice a year" FontSize="13" Foreground="#bdc3c7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel>
                <!-- Year selection -->
                <Border BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,16" Margin="0,0,0,24">
                    <DockPanel>
                        <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="YearTextBox" Width="100" Text="2026" Padding="8,6"/>
                        <Button Content="Year's QSOs" Margin="8,0,0,0" Padding="16,6" HorizontalAlignment="Left" Click="LoadButton_Click"/>
                        <TextBlock Text="(All 6 event dates are derived automatically from NCJ's fixed weekend-of-month schedule)" Foreground="#999999" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                </Border>

                <!-- CW -->
                <TextBlock Text="CW" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="160-10m" FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>

                <TextBlock Text="January (2nd full weekend)" Style="{StaticResource SubHeader}"/>
                <Grid Style="{StaticResource MetricGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwJanQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwJanMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwJanScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="August (1st full weekend)" Style="{StaticResource SubHeader}"/>
                <Grid Style="{StaticResource MetricGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwAugQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwAugMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwAugScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,8,0,16" Background="#e0e0e0"/>

                <!-- SSB -->
                <TextBlock Text="SSB" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="160-10m" FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>

                <TextBlock Text="January (3rd full weekend)" Style="{StaticResource SubHeader}"/>
                <Grid Style="{StaticResource MetricGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbJanQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbJanMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbJanScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="August (3rd full weekend)" Style="{StaticResource SubHeader}"/>
                <Grid Style="{StaticResource MetricGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbAugQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbAugMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbAugScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,8,0,16" Background="#e0e0e0"/>

                <!-- RTTY -->
                <TextBlock Text="RTTY" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="80-10m (no 160m)" FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>

                <TextBlock Text="February (last Saturday)" Style="{StaticResource SubHeader}"/>
                <Grid Style="{StaticResource MetricGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyFebQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyFebMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyFebScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="July (3rd full weekend)" Style="{StaticResource SubHeader}"/>
                <Grid Style="{StaticResource MetricGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyJulQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyJulMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyJulScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,8,0,24" Background="#e0e0e0"/>

                <!-- Combined Total -->
                <TextBlock Text="Combined Total (all 6 events)" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Total QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalScore, Mode=OneWay}"
                                   FontSize="28" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Formula: total valid QSOs x (US states + DC + Canadian provinces/territories + other North American DXCC countries worked), multipliers counted again on each band. Non-North-American contacts count as a QSO but grant no multiplier."
                           FontSize="11" Foreground="#999999" FontStyle="Italic" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
