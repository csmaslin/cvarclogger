<Window x:Class="CvarcLogger.App.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:behaviors="clr-namespace:CvarcLogger.App.Behaviors"
        mc:Ignorable="d"
        Title="Bulk Edit QSOs" Icon="/Assets/AppIcon.ico" Height="900" Width="1000" MinHeight="500" MinWidth="660" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="#E8F4FC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498db"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#3498db"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#3498db" Padding="0,8">
            <StackPanel>
                <TextBlock Text="BULK EDIT QSOs" FontSize="14" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock FontSize="12" FontWeight="Normal" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" MinHeight="0">
                    <Run Text="Editing"/>
                    <Run Text="{Binding QsoCount, Mode=OneWay}"/>
                    <Run Text="selected QSOs — only fields you fill in below will change. Blank fields are left alone."/>
                </TextBlock>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10,14,10" DockPanel.Dock="Bottom">
            <Button Content="Cancel" Click="Cancel_Click" ToolTip="Discard changes and close" Padding="14,4" Margin="0,0,8,0"
                    Background="#7f8c8d" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            <Button Content="Save" Command="{Binding SaveCommand}" ToolTip="Apply the entered fields to every selected QSO" Padding="14,4"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <Viewbox Stretch="Uniform">
    <StackPanel Margin="14" Width="660">
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Date/Time On (UTC)"/>
                <TextBox TextAlignment="Center" Text="{Binding QsoDateTimeUtcText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Time Off (UTC)"/>
                <TextBox TextAlignment="Center" Text="{Binding QsoDateTimeOffUtcText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="Callsign"/>
                <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="65">
                <TextBlock Text="Band"/>
                <ComboBox ItemsSource="{Binding Bands}" Text="{Binding Band, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Mode"/>
                <ComboBox ItemsSource="{Binding Modes}" Text="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Sub-Mode"/>
                <ComboBox ItemsSource="{Binding SubModes}" Text="{Binding SubMode, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="Freq (MHz)" TextWrapping="Wrap"/>
                <TextBox Text="{Binding FrequencyMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="70">
                <TextBlock Text="Freq Rx (MHz)" TextWrapping="Wrap"/>
                <TextBox Text="{Binding FrequencyRxMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="RST Sent" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding RstSent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="RST Rcvd" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding RstRcvd, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="160">
                <TextBlock Text="Name"/>
                <TextBox TextAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="Grid"/>
                <TextBox TextAlignment="Center" Text="{Binding GridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="City"/>
                <TextBox TextAlignment="Center" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="45">
                <TextBlock Text="State" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="100">
                <TextBlock Text="County"/>
                <TextBox TextAlignment="Center" Text="{Binding County, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="180">
                <TextBlock Text="Country"/>
                <TextBox TextAlignment="Center" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="60">
                <TextBlock Text="ARRL Section" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding ArrlSection, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="80">
                <TextBlock Text="Continent"/>
                <TextBox TextAlignment="Center" Text="{Binding Continent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="CQ Zone" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding CqZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="ITU Zone" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding ItuZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="80">
                <TextBlock Text="TX Power (W)"/>
                <TextBox TextAlignment="Center" Text="{Binding TxPowerWatts, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="140">
                <TextBlock Text="Station Callsign"/>
                <TextBox Text="{Binding StationCallsign, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="Operator"/>
                <TextBox Text="{Binding OperatorCallsign, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="My Grid"/>
                <TextBox TextAlignment="Center" Text="{Binding MyGridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="45">
                <TextBlock Text="My State" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding MyState, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="My County"/>
                <TextBox TextAlignment="Center" Text="{Binding MyCounty, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="QTH"/>
                <TextBox TextAlignment="Center" Text="{Binding Qth, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="OP"/>
                <TextBox TextAlignment="Center" Text="{Binding Op, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="UTC Offset (h)"/>
                <TextBox TextAlignment="Center" Text="{Binding UtcOffsetHours, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="Observes DST"/>
                <ComboBox ItemsSource="{Binding YesNoOptions}" SelectedItem="{Binding ObservesDaylightSavingTimeOption}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,0,8" Width="500">
                <TextBlock Text="Comment"/>
                <TextBox TextAlignment="Left" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="Contest / SKCC" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="Precedence"/>
                <TextBox TextAlignment="Center" Text="{Binding Precedence, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="55">
                <TextBlock Text="Check" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding Check, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="55">
                <TextBlock Text="Class"/>
                <TextBox TextAlignment="Center" Text="{Binding Class, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="60">
                <TextBlock Text="Seq #" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding StxSerial, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="80">
                <TextBlock Text="SKCC #" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding SkccNr, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="My SKCC #" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding MySkccNr, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                <Button Content="Lookup SKCC # for Selected" Command="{Binding SkccBulkLookupCommand}"
                        ToolTip="Look up each selected QSO's own callsign against the SKCC roster and fill in its SKCC # individually (does not use the SKCC # box above)"
                        Padding="14,4" Background="#FF9800" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="SOTA / POTA" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="My SOTA"/>
                <TextBox TextAlignment="Center" Text="{Binding MySotaRef, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="SOTA"/>
                <TextBox TextAlignment="Center" Text="{Binding SotaRef, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="160">
                <TextBlock Text="My POTA"/>
                <TextBox TextAlignment="Center" Text="{Binding MySigInfo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="160">
                <TextBlock Text="POTA"/>
                <TextBox TextAlignment="Center" Text="{Binding SigInfo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="QSL Status" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Sent"/>
                <ComboBox ItemsSource="{Binding QslStatusOptions}" SelectedItem="{Binding QslSentOption}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="QSL Sent Date"/>
                <TextBox TextAlignment="Center" Text="{Binding QslSentDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Rcvd"/>
                <ComboBox ItemsSource="{Binding QslStatusOptions}" SelectedItem="{Binding QslRcvdOption}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="QSL Rcvd Date"/>
                <TextBox TextAlignment="Center" Text="{Binding QslRcvdDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="QSL Via"/>
                <TextBox TextAlignment="Center" Text="{Binding QslViaCallsign, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Sent"/>
                <ComboBox ItemsSource="{Binding QslStatusOptions}" SelectedItem="{Binding LotwQslSentOption}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="LoTW Sent Date"/>
                <TextBox TextAlignment="Center" Text="{Binding LotwQslSentDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Rcvd"/>
                <ComboBox ItemsSource="{Binding QslStatusOptions}" SelectedItem="{Binding LotwQslRcvdOption}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="LoTW Rcvd Date"/>
                <TextBox TextAlignment="Center" Text="{Binding LotwQslRcvdDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
        </WrapPanel>
    </StackPanel>
        </Viewbox>
    </DockPanel>
</Window>
