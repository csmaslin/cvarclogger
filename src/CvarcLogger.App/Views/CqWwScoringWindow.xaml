<Window x:Class="CvarcLogger.App.Views.CqWwScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="CQ WW Scoring" Icon="/Assets/AppIcon.ico"
        Height="820" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#404040" Padding="24,16">
            <StackPanel>
                <emoji:TextBlock Text="🌐" FontSize="32" Foreground="White"/>
                <TextBlock Text="CQ WW DX Contest" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                <TextBlock Text="Separate SSB and CW event scoring, 160-10m" FontSize="13" Foreground="#bdc3c7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel>
                <!-- Year selection -->
                <Border BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,16" Margin="0,0,0,24">
                    <DockPanel>
                        <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="YearTextBox" Width="100" Text="2026" Padding="8,6"/>
                        <Button Content="Year's QSOs" Margin="8,0,0,0" Padding="16,6" HorizontalAlignment="Left" Click="LoadButton_Click"/>
                        <TextBlock Text="(Loads QSOs from specified year)" Foreground="#999999" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                </Border>

                <!-- SSB Event Section -->
                <TextBlock Text="SSB Event" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Last full weekend of October, Saturday 00:00 UTC – Sunday 23:59:59 UTC" Style="{StaticResource MetricLabel}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Zone Mult" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbZoneMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <TextBlock Text="Country Mult" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbCountryMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <!-- CW Event Section -->
                <TextBlock Text="CW Event" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Last full weekend of November, Saturday 00:00 UTC – Sunday 23:59:59 UTC" Style="{StaticResource MetricLabel}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Zone Mult" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwZoneMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <TextBlock Text="Country Mult" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwCountryMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <!-- Total Section -->
                <TextBlock Text="Combined Total" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Total QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Final Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalScore, Mode=OneWay}"
                                   FontSize="28" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Formula: QSO points x (Zone multiplier + Country multiplier), each multiplier counted once per band (160/80/40/20/15/10m only)"
                           FontSize="11" Foreground="#999999" FontStyle="Italic" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
