<Window x:Class="CvarcLogger.App.Views.ArrlContestsScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="ARRL Contests Scoring" Icon="/Assets/AppIcon.ico"
        Height="900" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#404040" Padding="24,16">
            <StackPanel>
                <emoji:TextBlock Text="🇺🇸" FontSize="32" Foreground="White"/>
                <TextBlock Text="ARRL Contests" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                <TextBlock Text="DX, 10-Meter, 160-Meter, and RTTY Roundup scoring" FontSize="13" Foreground="#bdc3c7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel>
                <Border BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,16" Margin="0,0,0,24">
                    <DockPanel>
                        <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="YearTextBox" Width="100" Text="2026" Padding="8,6"/>
                        <Button Content="Year's QSOs" Margin="8,0,0,0" Padding="16,6" HorizontalAlignment="Left" Click="LoadButton_Click"/>
                        <TextBlock Text="(All event dates derived automatically from ARRL's fixed weekend-of-month schedule)" Foreground="#999999" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                </Border>

                <!-- ARRL DX -->
                <TextBlock Text="ARRL DX Contest" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="160-10m. W/VE stations may only contact DX, and DX only W/VE." FontSize="11" Foreground="#999999" Margin="0,0,0,4"/>

                <TextBlock Text="CW (third full weekend of February)" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxCwQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxCwQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxCwMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxCwScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Phone (first full weekend of March)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxPhoneQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxPhoneQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxPhoneMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DxPhoneScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,20" Background="#e0e0e0"/>

                <!-- 10 Meter -->
                <TextBlock Text="10-Meter Contest" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Second full weekend of December. 10m only, any station may contact any other." FontSize="11" Foreground="#999999" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TenMeterQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TenMeterQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TenMeterMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TenMeterScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,20" Background="#e0e0e0"/>

                <!-- 160 Meter -->
                <TextBlock Text="160-Meter Contest" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="First full weekend of December (starts Friday). 160m CW only. DX may only contact W/VE." FontSize="11" Foreground="#999999" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OneSixtyQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OneSixtyQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OneSixtyMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OneSixtyScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,20" Background="#e0e0e0"/>

                <!-- RTTY Roundup -->
                <TextBlock Text="RTTY Roundup" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="First full weekend of January (never Jan 1). 80-10m, RTTY only." FontSize="11" Foreground="#999999" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,20" Background="#e0e0e0"/>

                <TextBlock Text="Coming Soon" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Listed on the ARRL contest calendar but not yet scored here:"
                           FontSize="12" Foreground="#666666" Margin="0,0,0,12"/>
                <StackPanel>
                    <TextBlock Text="• IARU HF World Championship -- July" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• 222 MHz and Up Distance Contest -- August" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• 10 GHz and Up Contest -- August and September" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• EME Contest -- August, September, October-November" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• ARRL Digital Contest -- June" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• School Club Roundup -- February and October" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• Rookie Roundup (SSB/RTTY/CW) -- April, August, December" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• Kids Day -- January and June (non-scored operating event)" FontSize="12" Foreground="#999999" Margin="0,0,0,4"/>
                    <TextBlock Text="• Straight Key Night -- January 1 (non-scored operating event)" FontSize="12" Foreground="#999999" Margin="0,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
