<UserControl x:Class="CvarcLogger.App.Views.QsoLogGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CvarcLogger.App.Views"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#f0f0f0" Margin="0,0,0,1" Padding="10,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Search:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="250" FontSize="13" Padding="6,4" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" ToolTip="Clear the search and show every QSO"
                            Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Station Log" FontSize="15" FontWeight="Bold" Foreground="#333333"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <DataGrid x:Name="LogDataGrid" Grid.Row="1" ItemsSource="{Binding QsosView}" SelectedItem="{Binding SelectedQso}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" VerticalGridLinesBrush="#BBBBBB"
                  CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserResizeColumns="True"
                  HeadersVisibility="All" RowHeaderWidth="36"
                  AlternationCount="2" AlternatingRowBackground="WhiteSmoke"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  LoadingRow="LogDataGrid_LoadingRow"
                  ColumnReordered="LogDataGrid_ColumnReordered"
                  SelectionChanged="LogDataGrid_SelectionChanged"
                  PreviewMouseRightButtonDown="LogDataGrid_PreviewMouseRightButtonDown"
                  PreviewKeyDown="LogDataGrid_PreviewKeyDown">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.CellStyle>
            <!-- Explicit ElementStyle on every column below (rather than relying on an implicit
                 TextBlock style) is the reliable way to center a DataGridTextColumn's generated
                 TextBlock. DataGridTextColumn assigns its own element outside the normal implicit
                 style lookup path, so an implicit style scoped to DataGrid.Resources silently had no
                 effect. ElementStyle is the column's own designed extension point for this. -->
            <DataGrid.Resources>
                <Style x:Key="CenteredCellText" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
                <!-- Left-aligned variant for the free-text columns (Name, Comment) where centering reads
                     awkwardly. Small left padding keeps the text off the cell's grid line. -->
                <Style x:Key="LeftCellText" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Left"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,0,0,0"/>
                </Style>
                <!-- Keep the selected row clearly highlighted even when keyboard focus is elsewhere (e.g.
                     while typing the next QSO in the entry form). By default WPF fades an unfocused grid's
                     selection to a faint gray that barely shows against the alternating-row shading, so the
                     current row looked like it had no highlight at all. Overriding both the active and the
                     inactive selection brushes keeps it the same clear blue with white text regardless of
                     which control currently has focus. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E7DD1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2E7DD1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E8F4FC"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!-- Border gives every header a visible right-edge separator line. The
                                     default header chrome's own separator blends into the background
                                     above and isn't reliably visible. -->
                                <Border BorderBrush="#dddddd" BorderThickness="0,0,1,0">
                                    <!-- Word-wraps onto a second line instead of truncating a header into a
                                         partial word or a hyphenated break when a column is narrower than its
                                         title (e.g. "ARRL Section", "Station Callsign"). -->
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                                               Padding="8,6"/>
                                </Border>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="UtcTimeColumn" local:ColumnKey.Key="UtcTime" Header="Date/Time (UTC)" Binding="{Binding QsoDateTimeOnUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" MinWidth="110" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="LocalTimeColumn" local:ColumnKey.Key="LocalTime" Header="Local Time" Binding="{Binding LocalDateTimeOn, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" MinWidth="90" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn local:ColumnKey.Key="Callsign" Header="Callsign" Binding="{Binding Callsign}" Width="90" MinWidth="75" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="BandColumn" local:ColumnKey.Key="Band" Header="Band" Binding="{Binding Band}" Width="55" MinWidth="40" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="ModeColumn" local:ColumnKey.Key="Mode" Header="Mode" Binding="{Binding Mode}" Width="70" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="FreqColumn" local:ColumnKey.Key="Freq" Header="Freq" Binding="{Binding FrequencyMhz}" Width="65" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="RstColumn" local:ColumnKey.Key="Rst" Header="RST S/R" Width="65" MinWidth="50" ElementStyle="{StaticResource CenteredCellText}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="RstSent"/>
                            <Binding Path="RstRcvd"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="NameColumn" local:ColumnKey.Key="Name" Header="Name" Binding="{Binding Name}" Width="110" MinWidth="45" ElementStyle="{StaticResource LeftCellText}"/>
                <DataGridTextColumn x:Name="GridColumn" local:ColumnKey.Key="Grid" Header="Grid" Binding="{Binding GridSquare}" Width="65" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="CityColumn" local:ColumnKey.Key="City" Header="City" Binding="{Binding City}" Width="100" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="StateColumn" local:ColumnKey.Key="State" Header="State" Binding="{Binding State}" Width="45" MinWidth="40" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="CountyColumn" local:ColumnKey.Key="County" Header="County" Binding="{Binding County}" Width="100" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="CountryColumn" local:ColumnKey.Key="Country" Header="Country" Binding="{Binding Country}" Width="120" MinWidth="60" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="ArrlSectionColumn" local:ColumnKey.Key="ArrlSection" Header="ARRL Section" Binding="{Binding ArrlSection}" Width="65" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="CqZoneColumn" local:ColumnKey.Key="CqZone" Header="CQ Zone" Binding="{Binding CqZone}" Width="50" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="ItuZoneColumn" local:ColumnKey.Key="ItuZone" Header="ITU Zone" Binding="{Binding ItuZone}" Width="50" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="ContinentColumn" local:ColumnKey.Key="Continent" Header="Continent" Binding="{Binding Continent}" Width="80" MinWidth="75" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="SubModeColumn" local:ColumnKey.Key="SubMode" Header="Sub Mode" Binding="{Binding SubMode}" Width="80" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="FreqRxColumn" local:ColumnKey.Key="FreqRx" Header="Freq Rx" Binding="{Binding FrequencyRxMhz}" Width="70" MinWidth="50" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="TxPowerColumn" local:ColumnKey.Key="TxPower" Header="TX Power" Binding="{Binding TxPowerWatts}" Width="70" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="QslColumn" local:ColumnKey.Key="Qsl" Header="QSL S/R" Width="80" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="QslSent"/>
                            <Binding Path="QslRcvd"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="LotwColumn" local:ColumnKey.Key="Lotw" Header="LoTW S/R" Width="80" MinWidth="60" ElementStyle="{StaticResource CenteredCellText}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="LotwQslSent"/>
                            <Binding Path="LotwQslRcvd"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="QslViaColumn" local:ColumnKey.Key="QslVia" Header="QSL Via" Binding="{Binding QslViaCallsign}" Width="90" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="TimeOffColumn" local:ColumnKey.Key="TimeOff" Header="Time Off (UTC)" Binding="{Binding QsoDateTimeOffUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" MinWidth="90" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="StationColumn" local:ColumnKey.Key="Station" Header="Station Callsign" Binding="{Binding StationCallsign}" Width="100" MinWidth="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="OperatorColumn" local:ColumnKey.Key="Operator" Header="Operator" Binding="{Binding OperatorCallsign}" Width="90" MinWidth="70" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="MyGridColumn" local:ColumnKey.Key="MyGrid" Header="My Grid" Binding="{Binding MyGridSquare}" Width="65" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="MyStateColumn" local:ColumnKey.Key="MyState" Header="My State" Binding="{Binding MyState}" Width="45" MinWidth="40" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="MyCountyColumn" local:ColumnKey.Key="MyCounty" Header="My County" Binding="{Binding MyCounty}" Width="100" MinWidth="65" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="QthColumn" local:ColumnKey.Key="Qth" Header="QTH" Binding="{Binding Qth}" Width="100" MinWidth="40" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="OpColumn" local:ColumnKey.Key="Op" Header="OP" Binding="{Binding Op}" Width="80" MinWidth="35" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="MySotaColumn" local:ColumnKey.Key="MySota" Header="My SOTA" Binding="{Binding MySotaRef}" Width="100" MinWidth="60" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="SotaColumn" local:ColumnKey.Key="Sota" Header="SOTA" Binding="{Binding SotaRef}" Width="100" MinWidth="60" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="MyPotaColumn" local:ColumnKey.Key="MyPota" Header="My POTA" Binding="{Binding MySigInfo}" Width="160" MinWidth="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="PotaColumn" local:ColumnKey.Key="Pota" Header="POTA" Binding="{Binding SigInfo}" Width="160" MinWidth="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <!-- Fixed width rather than "*" (star-sized/fill-remaining-space). A star column
                     absorbs whatever space other columns don't use, which works fine on a wide window
                     but gets squeezed to its MinWidth on a narrower one (e.g. maximized to a single
                     monitor). Once squeezed to the floor, it has no slack left to lend when resizing any
                     other column, so WPF silently refuses the resize instead of scrolling. A fixed width
                     avoids that failure mode entirely: widening any column just extends the grid's
                     total content width, triggering the horizontal scrollbar instead. -->
                <DataGridTextColumn x:Name="CommentColumn" local:ColumnKey.Key="Comment" Header="Comment" Binding="{Binding Comment}" Width="200" MinWidth="70" ElementStyle="{StaticResource LeftCellText}"/>
                <DataGridTextColumn x:Name="PrecedenceColumn" local:ColumnKey.Key="Precedence" Header="Precedence" Binding="{Binding Precedence}" Width="70" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="CheckColumn" local:ColumnKey.Key="Check" Header="Check" Binding="{Binding Check}" Width="55" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="ClassColumn" local:ColumnKey.Key="Class" Header="Class" Binding="{Binding Class}" Width="55" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="SkccColumn" local:ColumnKey.Key="Skcc" Header="SKCC #" Binding="{Binding SkccNr}" Width="80" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="MySkccColumn" local:ColumnKey.Key="MySkcc" Header="My SKCC #" Binding="{Binding MySkccNr}" Width="90" MinWidth="60" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="SequenceColumn" local:ColumnKey.Key="Sequence" Header="Seq #" Binding="{Binding StxSerial}" Width="60" MinWidth="45" ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
