<Window x:Class="CvarcLogger.App.Views.CabrilloExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Cabrillo" Height="620" Width="600"
        Background="White" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cabrillo Contest Info" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="CALLSIGN *" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="CallsignBox" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="CONTEST *" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ContestBox" Padding="6" Margin="0,0,0,10" IsEditable="True"
                          ToolTip="Contest identifier. Pick from the list or type your own.">
                    <ComboBoxItem>ARRL-DX-CW</ComboBoxItem>
                    <ComboBoxItem>ARRL-DX-SSB</ComboBoxItem>
                    <ComboBoxItem>ARRL-FIELD-DAY</ComboBoxItem>
                    <ComboBoxItem>ARRL-10-METER</ComboBoxItem>
                    <ComboBoxItem>ARRL-160-METER</ComboBoxItem>
                    <ComboBoxItem>ARRL-VHF-JAN</ComboBoxItem>
                    <ComboBoxItem>ARRL-VHF-JUN</ComboBoxItem>
                    <ComboBoxItem>ARRL-VHF-SEP</ComboBoxItem>
                    <ComboBoxItem>ARRL-RTTY</ComboBoxItem>
                    <ComboBoxItem>ARRL-SS-CW</ComboBoxItem>
                    <ComboBoxItem>ARRL-SS-SSB</ComboBoxItem>
                    <ComboBoxItem>ARRL-DIGI</ComboBoxItem>
                    <ComboBoxItem>CA-QSO-PARTY</ComboBoxItem>
                    <ComboBoxItem>CQ-160-CW</ComboBoxItem>
                    <ComboBoxItem>CQ-160-SSB</ComboBoxItem>
                    <ComboBoxItem>CQ-WPX-CW</ComboBoxItem>
                    <ComboBoxItem>CQ-WPX-RTTY</ComboBoxItem>
                    <ComboBoxItem>CQ-WPX-SSB</ComboBoxItem>
                    <ComboBoxItem>CQ-WW-CW</ComboBoxItem>
                    <ComboBoxItem>CQ-WW-RTTY</ComboBoxItem>
                    <ComboBoxItem>CQ-WW-SSB</ComboBoxItem>
                    <ComboBoxItem>CQ-WW-VHF</ComboBoxItem>
                    <ComboBoxItem>IARU-HF</ComboBoxItem>
                    <ComboBoxItem>NAQP-CW</ComboBoxItem>
                    <ComboBoxItem>NAQP-RTTY</ComboBoxItem>
                    <ComboBoxItem>NAQP-SSB</ComboBoxItem>
                    <ComboBoxItem>NA-SPRINT-CW</ComboBoxItem>
                    <ComboBoxItem>NA-SPRINT-SSB</ComboBoxItem>
                    <ComboBoxItem>WAE-DX-CW</ComboBoxItem>
                    <ComboBoxItem>WAE-DX-RTTY</ComboBoxItem>
                    <ComboBoxItem>WAE-DX-SSB</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="CATEGORY-OPERATOR" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryOperatorBox" Padding="6" Margin="0,0,0,10" IsEditable="True">
                    <ComboBoxItem>SINGLE-OP</ComboBoxItem>
                    <ComboBoxItem>MULTI-OP</ComboBoxItem>
                    <ComboBoxItem>CHECKLOG</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="CATEGORY-BAND" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryBandBox" Padding="6" Margin="0,0,0,10" IsEditable="True">
                    <ComboBoxItem>ALL</ComboBoxItem>
                    <ComboBoxItem>160M</ComboBoxItem>
                    <ComboBoxItem>80M</ComboBoxItem>
                    <ComboBoxItem>40M</ComboBoxItem>
                    <ComboBoxItem>20M</ComboBoxItem>
                    <ComboBoxItem>15M</ComboBoxItem>
                    <ComboBoxItem>10M</ComboBoxItem>
                    <ComboBoxItem>6M</ComboBoxItem>
                    <ComboBoxItem>2M</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="CATEGORY-MODE" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryModeBox" Padding="6" Margin="0,0,0,10" IsEditable="True">
                    <ComboBoxItem>MIXED</ComboBoxItem>
                    <ComboBoxItem>CW</ComboBoxItem>
                    <ComboBoxItem>SSB</ComboBoxItem>
                    <ComboBoxItem>RTTY</ComboBoxItem>
                    <ComboBoxItem>DIGI</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="CATEGORY-POWER" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryPowerBox" Padding="6" Margin="0,0,0,10" IsEditable="True">
                    <ComboBoxItem>HIGH</ComboBoxItem>
                    <ComboBoxItem>LOW</ComboBoxItem>
                    <ComboBoxItem>QRP</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="CATEGORY-STATION" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryStationBox" Padding="6" Margin="0,0,0,10" IsEditable="True">
                    <ComboBoxItem>FIXED</ComboBoxItem>
                    <ComboBoxItem>MOBILE</ComboBoxItem>
                    <ComboBoxItem>PORTABLE</ComboBoxItem>
                    <ComboBoxItem>ROVER</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="NAME" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="LOCATION (state/section)" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="LocationBox" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="CLAIMED SCORE" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="ClaimedScoreBox" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="EMAIL" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="SOAPBOX (optional comments)" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="SoapBoxBox" Padding="6" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Padding="20,8" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Export" Padding="20,8" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Click="Export_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
