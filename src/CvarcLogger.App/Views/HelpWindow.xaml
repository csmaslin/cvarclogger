<Window x:Class="CvarcLogger.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Background="#3498db" Padding="15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Search:" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" Width="280" Height="32" Padding="8,6" FontSize="13"
                         Style="{x:Null}" Background="White" Foreground="Black" BorderBrush="#cccccc" BorderThickness="1"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"/>
                <Button x:Name="FindButton" Content="Find" Width="70" Height="32" Margin="8,0,0,0"
                        Click="FindButton_Click" VerticalAlignment="Center"/>
                <Button x:Name="NextButton" Content="Next" Width="70" Height="32" Margin="6,0,0,0"
                        Click="NextButton_Click" VerticalAlignment="Center" IsEnabled="False"/>
                <TextBlock x:Name="ResultCount" Foreground="White" FontSize="13" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chapter List -->
            <ListBox x:Name="ResultsList" Grid.Column="0" Background="White" BorderBrush="#cccccc" BorderThickness="1"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="10"
                     SelectionChanged="ResultsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="#cccccc" HorizontalAlignment="Center"/>

            <!-- Manual Content Viewer -->
            <Border Grid.Column="2" Background="White" BorderBrush="#cccccc" BorderThickness="1" Margin="10">
                <RichTextBox x:Name="ContentViewer" IsReadOnly="True" BorderThickness="0" Background="White"
                             Padding="15" FontSize="13" FontFamily="Segoe UI, Roboto, sans-serif"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             IsDocumentEnabled="True"/>
            </Border>
        </Grid>
    </Grid>
</Window>
