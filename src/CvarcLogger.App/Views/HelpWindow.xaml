<Window x:Class="CvarcLogger.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Background="#3498db" Padding="15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 Search:" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" Width="300" Height="32" Padding="10,6" FontSize="13"
                         TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="ResultCount" Foreground="White" FontSize="13" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content Area: Either results list or full manual view -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results List (when searching) -->
            <ListBox x:Name="ResultsList" Grid.Column="0" Background="White" BorderBrush="#cccccc" BorderThickness="1"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="10"
                     MouseDoubleClick="ResultsList_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="#cccccc" HorizontalAlignment="Center"/>

            <!-- Manual Content Viewer -->
            <Border Grid.Column="2" Background="White" BorderBrush="#cccccc" BorderThickness="1" Margin="10">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ContentText" Padding="15" TextWrapping="Wrap" LineHeight="22"
                               Foreground="#333333" FontSize="12" FontFamily="Segoe UI, Consolas, monospace"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
