<Window x:Class="CvarcLogger.App.Views.SprintsScoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Sprints Scoring" Icon="/Assets/AppIcon.ico"
        Height="900" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="DateBox" TargetType="TextBox">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="TimeBox" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#404040" Padding="24,16">
            <StackPanel>
                <emoji:TextBlock Text="⚡" FontSize="32" Foreground="White"/>
                <TextBlock Text="Sprints" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                <TextBlock Text="CW / SSB / RTTY Sprint (80/40/20m) and ARRL VHF Contest (50 MHz and up) scoring" FontSize="13" Foreground="#bdc3c7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel>
                <TextBlock Text="Sprint contest dates vary by event and aren't a fixed weekend-of-month rule, so enter the exact UTC date and start/end time for the event you're scoring (date: yyyy-MM-dd, time: HH:mm)."
                           FontSize="12" Foreground="#999999" FontStyle="Italic" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <!-- CW Sprint -->
                <TextBlock Text="CW Sprint" Style="{StaticResource SectionHeader}"/>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Date (UTC):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="CwDateBox" Style="{StaticResource DateBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="CwStartBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="CwEndBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <Button Content="Score CW Sprint" Padding="16,6" Click="ScoreCw_Click"/>
                </DockPanel>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CwScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <!-- SSB Sprint -->
                <TextBlock Text="SSB Sprint" Style="{StaticResource SectionHeader}"/>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Date (UTC):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SsbDateBox" Style="{StaticResource DateBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SsbStartBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SsbEndBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <Button Content="Score SSB Sprint" Padding="16,6" Click="ScoreSsb_Click"/>
                </DockPanel>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SsbScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <!-- RTTY Sprint -->
                <TextBlock Text="RTTY Sprint" Style="{StaticResource SectionHeader}"/>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Date (UTC):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="RttyDateBox" Style="{StaticResource DateBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="RttyStartBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="RttyEndBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <Button Content="Score RTTY Sprint" Padding="16,6" Click="ScoreRtty_Click"/>
                </DockPanel>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Multiplier" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RttyScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" Background="#e0e0e0"/>

                <TextBlock Text="Formula (CW/SSB/RTTY Sprints): total valid QSOs x (US states + DC + Canadian provinces/territories + other North American DXCC countries worked). US and Canada themselves never count as countries; non-North-American contacts count as a QSO but grant no multiplier."
                           FontSize="11" Foreground="#999999" FontStyle="Italic" Margin="0,0,0,24" TextWrapping="Wrap"/>

                <!-- VHF/UHF Contest -->
                <TextBlock Text="VHF/UHF Contest" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="ARRL January/June/September VHF Contest, fixed-station scoring. All modes count; any band 50 MHz and up."
                           FontSize="12" Foreground="#666666" Margin="0,0,0,16"/>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="VhfMonthCombo" Width="110" Margin="0,0,16,0" SelectedIndex="0">
                        <ComboBoxItem Content="January"/>
                        <ComboBoxItem Content="June"/>
                        <ComboBoxItem Content="September"/>
                    </ComboBox>
                    <TextBlock Text="Date (UTC):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="VhfDateBox" Style="{StaticResource DateBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="VhfStartBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="VhfEndBox" Style="{StaticResource TimeBox}" Margin="0,0,16,0"/>
                    <Button Content="Score VHF Contest" Padding="16,6" Click="ScoreVhf_Click"/>
                </DockPanel>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="QSOs" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding VhfQsoCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="QSO Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding VhfQsoPoints, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Grid Mult" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding VhfGridMultiplier, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Score" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding VhfScore, Mode=OneWay}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Formula (VHF/UHF Contest): total QSO points (1 pt/50-144MHz, 2 pt/222-432MHz, 4 or 3 pt/902-1296MHz, 8 or 4 pt/2.3GHz+, January vs June-September) x total 4-character grid squares worked, counted once per band."
                           FontSize="11" Foreground="#999999" FontStyle="Italic" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
