<Window x:Class="CvarcLogger.App.Views.QsoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:CvarcLogger.App.Converters"
        xmlns:behaviors="clr-namespace:CvarcLogger.App.Behaviors"
        mc:Ignorable="d"
        Title="Edit QSO" Icon="/Assets/AppIcon.ico" Height="900" Width="1000" MinHeight="500" MinWidth="660" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="#E8F4FC">
    <!-- Return saves the edited QSO, mirroring the main entry form where Return logs the QSO. -->
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <converters:SubModeVisibilityConverter x:Key="SubModeVisibilityConverter"/>
        <!-- No fixed Height (unlike before): natural sizing from Padding+FontSize so a larger FontSize
             here automatically grows the box to fit, the same "no explicit Height" lesson the main entry
             form's fields already settled on. ComboBox's extra dropdown-arrow chrome makes its natural
             height a few px different from a plain TextBox's; Padding is tuned per control below so both
             land close enough not to visibly mismatch row to row. The whole form sits inside a Viewbox
             (see below), so this natural height still scales proportionally with everything else. -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Beta feedback: hard to tell which field currently has the text cursor. Thicker +
                 accent-blue border on focus, same treatment as the main entry form (see App.xaml).
                 This window defines its own local TextBox/ComboBox styles, which shadow the App.xaml
                 ones, so it needs its own copy of the trigger rather than inheriting it. -->
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498db"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#3498db"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Centers every field caption over its input control (each is the first child of its own
             StackPanel, directly above a TextBox/ComboBox), and reserves the same MinHeight for all of
             them regardless of whether a given one wraps onto a second line (several do, on the
             narrower columns: RST Sent/Rcvd, State, ARRL Section, CQ/ITU Zone, My State). Without a
             shared MinHeight, a wrapped 2-line caption is taller than its 1-line neighbors, and
             StackPanel pushes that field's input box down relative to the rest of the row. Also applies
             to the "SOTA / POTA"/"QSL Status" section headings and the "EDIT QSO" banner title, which
             already set TextAlignment explicitly inline; a local value always wins over this style, so
             those are unaffected. -->
        <Style TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#3498db" Padding="0,8">
            <TextBlock Text="EDIT QSO" FontSize="14" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10,14,10" DockPanel.Dock="Bottom">
            <Button x:Name="LookupButton" Content="Lookup" Command="{Binding LookupCommand}" ToolTip="Look up this callsign online" Padding="14,4" Margin="0,0,8,0"
                    Background="#3498db" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            <Button x:Name="ClearLookupButton" Content="Clear &amp; Lookup" Click="ClearLookup_Click" ToolTip="Clear lookup fields and look up this callsign fresh" Padding="14,4" Margin="0,0,8,0"
                    Background="#1976d2" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            <Button Content="Cancel" Click="Cancel_Click" ToolTip="Discard changes and close" Padding="14,4" Margin="0,0,8,0"
                    Background="#7f8c8d" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            <Button Content="Save" Command="{Binding SaveCommand}" ToolTip="Save changes to this QSO" Padding="14,4"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <!-- Fixed Width so the WrapPanels below wrap predictably regardless of window size. Viewbox
             always measures its child at infinite available size to learn its natural size. -->
        <Viewbox Stretch="Uniform">
    <StackPanel Margin="14" Width="800">
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Date/Time On (UTC)"/>
                <TextBox TextAlignment="Center" Text="{Binding QsoDateTimeUtcText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Local Date/Time"/>
                <TextBox TextAlignment="Center" Text="{Binding LocalDateTimeText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Time Off (UTC)"/>
                <TextBox TextAlignment="Center" Text="{Binding QsoDateTimeOffUtcText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="Callsign"/>
                <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="65">
                <TextBlock Text="Band"/>
                <ComboBox ItemsSource="{Binding Bands}" SelectedItem="{Binding Band}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Mode"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90"
                        Visibility="{Binding Mode, Converter={StaticResource SubModeVisibilityConverter}}">
                <TextBlock Text="Sub-Mode"/>
                <ComboBox ItemsSource="{Binding SubModes}" SelectedItem="{Binding SubMode}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="Freq (MHz)" TextWrapping="Wrap"/>
                <TextBox Text="{Binding FrequencyMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="70">
                <TextBlock Text="Freq Rx (MHz)" TextWrapping="Wrap"/>
                <TextBox Text="{Binding FrequencyRxMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="RST Sent" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding RstSent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="RST Rcvd" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding RstRcvd, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="160">
                <TextBlock Text="Name"/>
                <TextBox TextAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="Grid"/>
                <TextBox TextAlignment="Center" Text="{Binding GridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="City"/>
                <TextBox TextAlignment="Center" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="45">
                <TextBlock Text="State" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="100">
                <TextBlock Text="County"/>
                <TextBox TextAlignment="Center" Text="{Binding County, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="180">
                <TextBlock Text="Country"/>
                <TextBox TextAlignment="Center" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="60">
                <TextBlock Text="ARRL Section" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding ArrlSection, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="80">
                <TextBlock Text="Continent"/>
                <TextBox TextAlignment="Center" Text="{Binding Continent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="CQ Zone" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding CqZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="50">
                <TextBlock Text="ITU Zone" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding ItuZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="80">
                <TextBlock Text="TX Power (W)"/>
                <TextBox TextAlignment="Center" Text="{Binding TxPowerWatts, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="140">
                <TextBlock Text="Station Callsign"/>
                <TextBox Text="{Binding StationCallsign, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="Operator"/>
                <TextBox Text="{Binding OperatorCallsign, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="My Grid"/>
                <TextBox TextAlignment="Center" Text="{Binding MyGridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="45">
                <TextBlock Text="My State" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding MyState, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="My County"/>
                <TextBox TextAlignment="Center" Text="{Binding MyCounty, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="QTH"/>
                <TextBox TextAlignment="Center" Text="{Binding Qth, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="OP"/>
                <TextBox TextAlignment="Center" Text="{Binding Op, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="UTC Offset (h)"/>
                <TextBox TextAlignment="Center" Text="{Binding UtcOffsetHours, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110" VerticalAlignment="Bottom">
                <CheckBox Content="Observes DST" IsChecked="{Binding ObservesDaylightSavingTime}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="120">
                <TextBlock Text="Contest ID" TextWrapping="Wrap"/>
                <TextBox TextAlignment="Center" Text="{Binding ContestId, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,0,8" Width="500">
                <TextBlock Text="Comment"/>
                <TextBox TextAlignment="Left" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="SOTA / POTA" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="My SOTA"/>
                <TextBox TextAlignment="Center" Text="{Binding MySotaRef, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="SOTA"/>
                <TextBox TextAlignment="Center" Text="{Binding SotaRef, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="160">
                <TextBlock Text="My POTA"/>
                <TextBox TextAlignment="Center" Text="{Binding MySigInfo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="160">
                <TextBlock Text="POTA"/>
                <TextBox TextAlignment="Center" Text="{Binding SigInfo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="SKCC" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="SKCC #"/>
                <TextBox TextAlignment="Center" Text="{Binding SkccNr, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="My SKCC #"/>
                <TextBox TextAlignment="Center" Text="{Binding MySkccNr, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                <Button Content="Lookup" Command="{Binding SkccLookupCommand}" ToolTip="Look up this callsign's SKCC number from the member roster"
                        Padding="14,4" Background="#FF9800" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="QSL Status" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Sent"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslSent}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="QSL Sent Date"/>
                <TextBox TextAlignment="Center" Text="{Binding QslSentDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Rcvd"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslRcvd}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="QSL Rcvd Date"/>
                <TextBox TextAlignment="Center" Text="{Binding QslRcvdDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="QSL Via"/>
                <TextBox TextAlignment="Center" Text="{Binding QslViaCallsign, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Sent"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslSent}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="LoTW Sent Date"/>
                <TextBox TextAlignment="Center" Text="{Binding LotwQslSentDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Rcvd"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslRcvd}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="LoTW Rcvd Date"/>
                <TextBox TextAlignment="Center" Text="{Binding LotwQslRcvdDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
        </WrapPanel>
    </StackPanel>
        </Viewbox>
    </DockPanel>
</Window>
