<Window x:Class="CvarcLogger.App.Views.QsoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:CvarcLogger.App.Converters"
        mc:Ignorable="d"
        Title="Edit QSO" Height="500" Width="660" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:DataModeVisibilityConverter x:Key="DataModeVisibilityConverter"/>
    </Window.Resources>
    <StackPanel Margin="14">
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Date/Time (UTC)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding QsoDateTimeUtcText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="140">
                <TextBlock Text="Callsign" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="0,18,10,8" VerticalAlignment="Top">
                <Button Content="Lookup" Command="{Binding LookupCommand}" Padding="10,4"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Band" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding Bands}" SelectedItem="{Binding Band}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Mode" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90"
                        Visibility="{Binding Mode, Converter={StaticResource DataModeVisibilityConverter}}">
                <TextBlock Text="Sub-Mode" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding SubModes}" SelectedItem="{Binding SubMode}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="100">
                <TextBlock Text="Freq (MHz)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding FrequencyMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="RST Sent" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding RstSent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="RST Rcvd" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding RstRcvd, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="160">
                <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Grid" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding GridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="City" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="60">
                <TextBlock Text="State" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="100">
                <TextBlock Text="County" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding County, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="180">
                <TextBlock Text="Country" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="ARRL Section" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding ArrlSection, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="CQ Zone" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding CqZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="70">
                <TextBlock Text="ITU Zone" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding ItuZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,0,8" Width="500">
                <TextBlock Text="Comment" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="QSL Status" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Sent" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslSent}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Rcvd" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslRcvd}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Sent" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslSent}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="130">
                <TextBlock Text="LoTW Rcvd" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslRcvd}"/>
            </StackPanel>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>
