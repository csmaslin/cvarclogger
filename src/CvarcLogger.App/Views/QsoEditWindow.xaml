<Window x:Class="CvarcLogger.App.Views.QsoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:CvarcLogger.App.Converters"
        xmlns:behaviors="clr-namespace:CvarcLogger.App.Behaviors"
        mc:Ignorable="d"
        Title="Edit QSO" Icon="/Assets/AppIcon.ico" Height="700" Width="700" MinHeight="500" MinWidth="660" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:SubModeVisibilityConverter x:Key="SubModeVisibilityConverter"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="MediumBlue" Padding="0,8">
            <TextBlock Text="EDIT QSO" FontSize="14" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10,14,10" DockPanel.Dock="Bottom">
            <Button Content="Lookup" Command="{Binding LookupCommand}" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
        <!-- Fixed Width so the WrapPanels below wrap predictably regardless of window size. Viewbox
             always measures its child at infinite available size to learn its natural size. -->
        <Viewbox Stretch="Uniform">
    <StackPanel Margin="14" Width="660">
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Date/Time On (UTC)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding QsoDateTimeUtcText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="150">
                <TextBlock Text="Local Date/Time" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding LocalDateTimeText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd HH:mm"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="140">
                <TextBlock Text="Callsign" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Band" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding Bands}" SelectedItem="{Binding Band}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Mode" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90"
                        Visibility="{Binding Mode, Converter={StaticResource SubModeVisibilityConverter}}">
                <TextBlock Text="Sub-Mode" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding SubModes}" SelectedItem="{Binding SubMode}" IsEditable="True"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="Freq (MHz)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding FrequencyMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="100">
                <TextBlock Text="Freq Rx (MHz)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding FrequencyRxMhz, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="RST Sent" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding RstSent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="RST Rcvd" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding RstRcvd, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="160">
                <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="Grid" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding GridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="City" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="60">
                <TextBlock Text="State" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="100">
                <TextBlock Text="County" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding County, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="180">
                <TextBlock Text="Country" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="ARRL Section" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding ArrlSection, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="80">
                <TextBlock Text="Continent" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Continent, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="CQ Zone" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding CqZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="70">
                <TextBlock Text="ITU Zone" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding ItuZone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="80">
                <TextBlock Text="TX Power (W)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding TxPowerWatts, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="140">
                <TextBlock Text="Station Callsign" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding StationCallsign, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="Operator" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding OperatorCallsign, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="My Grid" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding MyGridSquare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="60">
                <TextBlock Text="My State" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding MyState, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="My County" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding MyCounty, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="100">
                <TextBlock Text="QTH" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Qth, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="OP" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Op, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="90">
                <TextBlock Text="UTC Offset (h)" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding UtcOffsetHours, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110" VerticalAlignment="Bottom">
                <CheckBox Content="Observes DST" IsChecked="{Binding ObservesDaylightSavingTime}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel>
            <StackPanel Margin="0,0,0,8" Width="500">
                <TextBlock Text="Comment" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="SOTA / POTA" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="My SOTA" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding MySotaRef, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="120">
                <TextBlock Text="SOTA" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding SotaRef, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="My POTA" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding MySigInfo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="POTA" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding SigInfo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,4,0,10"/>

        <TextBlock Text="QSL Status" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Sent" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslSent}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="QSL Sent Date" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding QslSentDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="QSL Rcvd" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding QslRcvd}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="QSL Rcvd Date" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding QslRcvdDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="QSL Via" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding QslViaCallsign, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Sent" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslSent}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="110">
                <TextBlock Text="LoTW Sent Date" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding LotwQslSentDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,8" Width="130">
                <TextBlock Text="LoTW Rcvd" FontSize="11" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding QslStatuses}" SelectedItem="{Binding LotwQslRcvd}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Width="110">
                <TextBlock Text="LoTW Rcvd Date" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding LotwQslRcvdDateText, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:DateInputMask.Format="yyyy-MM-dd"/>
            </StackPanel>
        </WrapPanel>
    </StackPanel>
        </Viewbox>
    </DockPanel>
</Window>
