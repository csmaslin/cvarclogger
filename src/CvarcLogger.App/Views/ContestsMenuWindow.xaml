<Window x:Class="CvarcLogger.App.Views.ContestsMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Contests (Beta)" Icon="/Assets/AppIcon.ico"
        Height="820" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Sidebar nav item: a RadioButton styled to look like the old left-placed TabItem strip
             (same colors/padding/left accent bar), so moving the tabs into the sidebar changes only
             where they're drawn, not how they look or behave. Checked == that page's content shows. -->
        <Style x:Key="SidebarNavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="4,0,0,0"
                                Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#34495e"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2a2a2a"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Headerless TabControl: keeps TabItem/TabControl for content + SelectedIndex switching
             (so every TabItem's content, including the existing Click handlers, is unchanged) but
             renders only the selected page, with no built-in tab strip, since that job moved to the
             SidebarNavItem RadioButtons above. -->
        <Style x:Key="HeaderlessTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#404040">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <emoji:TextBlock Text="🏆" FontSize="42" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,6"/>
                    <TextBlock Text="Contests (Beta)" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Score your log" FontSize="11" Foreground="#bdc3c7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="FieldDayNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 IsChecked="True" Checked="ContestNav_Checked" Tag="0">
                        <emoji:TextBlock Text="📻  Field Day (Beta)" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SweepstakesNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 Checked="ContestNav_Checked" Tag="1">
                        <StackPanel>
                            <emoji:TextBlock Text="🌐  ARRL" FontSize="14"/>
                            <TextBlock Text="Sweepstakes (Beta)" FontSize="14" Margin="24,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CqWwNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 Checked="ContestNav_Checked" Tag="2">
                        <emoji:TextBlock Text="🌐  CQ WW (Beta)" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SprintsNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 Checked="ContestNav_Checked" Tag="3">
                        <emoji:TextBlock Text="⚡  Sprints (Beta)" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="NaqpNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 Checked="ContestNav_Checked" Tag="4">
                        <emoji:TextBlock Text="🌐  NAQP (Beta)" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="ArrlContestsNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 Checked="ContestNav_Checked" Tag="5">
                        <emoji:TextBlock Text="🇺🇸  ARRL Contests (Beta)" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="SkccNavItem" GroupName="ContestNav" Style="{StaticResource SidebarNavItem}"
                                 Checked="ContestNav_Checked" Tag="6">
                        <emoji:TextBlock Text="💻  SKCC (Coming Soon)" FontSize="14"/>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
                <TextBlock Text="Contest Scoring" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
            </Border>

            <TabControl x:Name="ContestTabControl" Grid.Row="1" Style="{StaticResource HeaderlessTabControl}"
                        Background="White" BorderBrush="#dddddd" BorderThickness="1">
                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="📻  Field Day (Beta)" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="📻" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="ARRL Field Day" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score your Field Day log with per-mode QSO points, power multiplier, and bonus checklist."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open Field Day Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="FieldDay_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel>
                            <emoji:TextBlock Text="🌐  ARRL" FontSize="14"/>
                            <TextBlock Text="Sweepstakes (Beta)" FontSize="14" Margin="24,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="🌐" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="ARRL Sweepstakes" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score your Sweepstakes log with separate CW and Phone event scoring."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open Sweepstakes Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="Sweepstakes_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="🌐  CQ WW (Beta)" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="🌐" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="CQ WW DX Contest" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score your CQ WW log with separate SSB and CW event scoring across 160-10m."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open CQ WW Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="CqWw_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="⚡  Sprints (Beta)" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="⚡" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="Sprints" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score CW / SSB / RTTY Sprints on 80/40/20m, and the ARRL VHF Contest on 50 MHz and up."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open Sprints Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="Sprints_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="🌐  NAQP (Beta)" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="🌐" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="NAQP" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score your North American QSO Party log: CW, SSB, and RTTY, each run twice a year."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open NAQP Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="Naqp_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="🇺🇸  ARRL Contests (Beta)" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="🇺🇸" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="ARRL Contests" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score the ARRL DX Contest, 10-Meter Contest, 160-Meter Contest, and RTTY Roundup."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open ARRL Contests Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="ArrlContests_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="💻  SKCC (Coming Soon)" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="💻" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="SKCC" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Straight Key Century Club contest tracking and scoring."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="(Scoring implementation coming in the next phase)"
                                   FontSize="12" Foreground="#999999" FontStyle="Italic" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
