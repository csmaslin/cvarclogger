<Window x:Class="CvarcLogger.App.Views.ContestsMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Contests" Icon="/Assets/AppIcon.ico"
        Height="820" Width="1250" MinHeight="600" MinWidth="1000"
        Background="#f5f5f5" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="SidebarTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="4,0,0,0"
                                Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#34495e"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2a2a2a"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#404040">
            <StackPanel Margin="16,20,16,16">
                <emoji:TextBlock Text="🏆" FontSize="42" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,6"/>
                <TextBlock Text="Contests" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Score your log" FontSize="11" Foreground="#bdc3c7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
                <TextBlock Text="Contest Scoring" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
            </Border>

            <TabControl Grid.Row="1" TabStripPlacement="Left" Background="White" BorderBrush="#dddddd"
                        ItemContainerStyle="{StaticResource SidebarTabItem}">
                <TabItem>
                    <TabItem.Header>
                        <emoji:TextBlock Text="📻  Field Day" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <emoji:TextBlock Text="📻" FontSize="64" HorizontalAlignment="Center" Foreground="#404040"/>
                        <TextBlock Text="ARRL Field Day" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Score your Field Day log with per-mode QSO points, power multiplier, and bonus checklist."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Width="480" TextAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="Open Field Day Scorer" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="FieldDay_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem IsEnabled="False">
                    <TabItem.Header>
                        <emoji:TextBlock Text="🌐  ARRL Sweepstakes" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <TextBlock Text="Coming soon" FontSize="16" Foreground="#999999" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem>

                <TabItem IsEnabled="False">
                    <TabItem.Header>
                        <emoji:TextBlock Text="🌐  CQ WW" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <TextBlock Text="Coming soon" FontSize="16" Foreground="#999999" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem>

                <TabItem IsEnabled="False">
                    <TabItem.Header>
                        <emoji:TextBlock Text="🌐  NAQP" FontSize="14"/>
                    </TabItem.Header>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <TextBlock Text="Coming soon" FontSize="16" Foreground="#999999" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
