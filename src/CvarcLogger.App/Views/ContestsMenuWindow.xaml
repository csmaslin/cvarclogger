<Window x:Class="CvarcLogger.App.Views.ContestsMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Contests" Width="500"
        Background="White" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" SizeToContent="Height">
    <StackPanel Margin="30">
        <Border BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
            <TextBlock Text="🏆 Contests" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
        </Border>

        <TextBlock Text="Score a contest against the log:" Foreground="#666666" Margin="0,0,0,15"/>

        <!-- Field Day -->
        <Button Padding="14,16" Foreground="#2c2c2c" ToolTip="ARRL Field Day scoring"
                Background="#f9f9f9" BorderBrush="#ccc" BorderThickness="1"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="0,0,0,8" Click="FieldDay_Click">
            <emoji:TextBlock Text="📻 Field Day" FontSize="14" Foreground="#2c2c2c"/>
        </Button>

        <!-- Placeholders for future scorers -->
        <Button Padding="14,16" Foreground="#999999" ToolTip="Not yet implemented"
                Background="#f5f5f5" BorderBrush="#ddd" BorderThickness="1"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="0,0,0,8" IsEnabled="False">
            <emoji:TextBlock Text="🌐 Sweepstakes (coming soon)" FontSize="14" Foreground="#999999"/>
        </Button>
        <Button Padding="14,16" Foreground="#999999" ToolTip="Not yet implemented"
                Background="#f5f5f5" BorderBrush="#ddd" BorderThickness="1"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="0,0,0,8" IsEnabled="False">
            <emoji:TextBlock Text="🌐 CQ WW (coming soon)" FontSize="14" Foreground="#999999"/>
        </Button>
        <Button Padding="14,16" Foreground="#999999" ToolTip="Not yet implemented"
                Background="#f5f5f5" BorderBrush="#ddd" BorderThickness="1"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="0,0,0,8" IsEnabled="False">
            <emoji:TextBlock Text="🌐 NAQP (coming soon)" FontSize="14" Foreground="#999999"/>
        </Button>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Close" Padding="20,10" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
