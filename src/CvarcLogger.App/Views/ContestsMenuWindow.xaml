<Window x:Class="CvarcLogger.App.Views.ContestsMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Contests" Icon="/Assets/AppIcon.ico"
        Height="480" Width="720"
        Background="#f5f5f5" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize" MinHeight="360" MinWidth="560">

    <Window.Resources>
        <!-- Dark left-panel button matching the main window's SidebarButtonStyle look -->
        <Style x:Key="DarkTileButton" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4a4a4a"/>
                                <Setter Property="BorderBrush" Value="#3498db"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2a2a2a"/>
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left dark rail: matches main window sidebar -->
        <Border Grid.Column="0" Background="#404040">
            <StackPanel Margin="16,20,16,16">
                <emoji:TextBlock Text="🏆" FontSize="42" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,6"/>
                <TextBlock Text="Contests" FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Score your log" FontSize="11" Foreground="#bdc3c7"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#e0e0e0" Padding="0,0,0,10" Margin="0,0,0,15">
                <TextBlock Text="Choose a Contest" FontSize="18" FontWeight="Bold" Foreground="#000000"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Style="{StaticResource DarkTileButton}" Click="FieldDay_Click"
                            ToolTip="ARRL Field Day scoring">
                        <emoji:TextBlock Text="📻   ARRL Field Day" Foreground="#ecf0f1" FontSize="14"/>
                    </Button>

                    <Button Style="{StaticResource DarkTileButton}" IsEnabled="False"
                            ToolTip="Not yet implemented">
                        <emoji:TextBlock Text="🌐   ARRL Sweepstakes  (coming soon)" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DarkTileButton}" IsEnabled="False"
                            ToolTip="Not yet implemented">
                        <emoji:TextBlock Text="🌐   CQ WW  (coming soon)" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DarkTileButton}" IsEnabled="False"
                            ToolTip="Not yet implemented">
                        <emoji:TextBlock Text="🌐   NAQP  (coming soon)" FontSize="14"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
