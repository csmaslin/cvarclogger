<Window x:Class="CvarcLogger.App.Views.ColumnPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Choose Columns" Height="560" Width="280" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Callsign and Date/Time (UTC) are always shown."
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Click="Close_Click"
                Padding="14,4" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ColumnOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsVisible}" Margin="0,0,0,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
