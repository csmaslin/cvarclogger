<Window x:Class="CvarcLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CvarcLogger.App.Views"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="CVARC Logger" Icon="/Assets/AppIcon.ico" Height="820" Width="1450"
        Loaded="Window_Loaded"
        Background="#f5f5f5">

    <Window.Resources>
        <Color x:Key="DoveGrey">#404040</Color>
        <Color x:Key="LightBlue">#34495e</Color>
        <Color x:Key="BlueAccent">#3498db</Color>
        <Color x:Key="StickyBg">#ecf0f1</Color>
        <SolidColorBrush x:Key="DoveGreyBrush" Color="#404040"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#34495e"/>
        <SolidColorBrush x:Key="BlueAccentBrush" Color="#3498db"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#f5f5f5"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActiveStyle" BasedOn="{StaticResource SidebarButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#f5f5f5">
        <!-- TOP BANNER -->
        <Border DockPanel.Dock="Top" Background="#3498db" Height="100" Padding="20,0,20,0">
            <DockPanel>
                <Image Source="/Assets/BannerLogo.png" Height="80" DockPanel.Dock="Left" Margin="0,10,15,10" VerticalAlignment="Center"/>
                <Image Source="/Assets/218-2180558_arrl-logo-hd-png-download.png" Height="80" DockPanel.Dock="Left" Margin="0,10,15,10" VerticalAlignment="Center"/>
                <TextBlock Text="CVARC LOGGER" FontSize="36" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           FontFamily="Segoe UI, Roboto, sans-serif"/>
            </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding QsoLog.Qsos.Count, Mode=OneWay}"/>
                    <Run Text=" QSOs logged"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LogNameText"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="Program by W6CSM"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
        </StatusBar>

        <!-- MAIN CONTENT WITH SIDEBAR -->
        <Grid Background="#404040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#34495e" BorderBrush="#999999" BorderThickness="0,0,2,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="10,20,10,20">
                        <!-- File Operations Button -->
                        <Button Name="FileButton" Click="FileButton_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📁 File"/>
                        </Button>

                        <!-- Station Configuration Button -->
                        <Button Name="StationButton" Click="StationButton_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📍 Station"/>
                        </Button>

                        <!-- CAT Control Button -->
                        <Button Name="CatButton" Click="CatButton_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📡 CAT"/>
                        </Button>

                        <!-- Lookup Sources Button -->
                        <Button Name="LookupButton" Click="LookupButton_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🔍 Lookup"/>
                        </Button>

                        <!-- Column Visibility Button -->
                        <Button Name="ColumnsButton" Click="ColumnsButton_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="⚙️ Columns"/>
                        </Button>

                        <!-- Divider -->
                        <Separator Height="2" Margin="0,20,0,20" Background="#666666"/>

                        <!-- Mode Selection Buttons -->
                        <Button Name="NormalModeButton" Click="NormalMode_Click"
                                Style="{StaticResource SidebarButtonActiveStyle}">
                            <emoji:TextBlock Text="📝 Normal"/>
                        </Button>

                        <Button Name="ContestModeButton" Click="ContestMode_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🏆 Contest"/>
                        </Button>

                        <Button Name="SotaModeButton" Click="SotaMode_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="⛰️ SOTA"/>
                        </Button>

                        <Button Name="PotaModeButton" Click="PotaMode_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🪑 POTA"/>
                        </Button>

                        <Button Name="AllModeButton" Click="AllMode_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📊 All"/>
                        </Button>

                        <!-- Divider -->
                        <Separator Height="2" Margin="0,20,0,20" Background="#666666"/>

                        <!-- Award Progress Button -->
                        <Button Name="AwardButton" Click="AwardsMenuItem_Click"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🏅 Award"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CONTENT AREA -->
            <Grid Grid.Column="1" Background="#404040" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- ENTRY FORM -->
                <Border Grid.Row="0" Background="White" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="4" Margin="0,0,0,15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:QsoEntryView DataContext="{Binding QsoEntry}"/>
                    </ScrollViewer>
                </Border>

                <!-- LOG GRID RIBBON -->
                <Border Grid.Row="1" Background="#404040" BorderBrush="#cccccc" BorderThickness="2"
                        CornerRadius="4" Padding="20,12" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- CAT Status Indicator -->
                        <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#999999" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Foreground="#cccccc" FontSize="12" VerticalAlignment="Center" Text="CAT: Disconnected"/>
                            </StackPanel>
                        </Border>

                        <!-- Connect CAT Button -->
                        <Button Name="CatConnectButton" Click="CatConnect_Click"
                               Background="#3498db" Foreground="White" VerticalAlignment="Center"
                               Padding="12,6" BorderThickness="0" Margin="0,0,10,0">
                            <emoji:TextBlock Text="📡 Connect CAT" FontSize="12" Foreground="White"/>
                        </Button>

                        <!-- Columns Button -->
                        <Button Name="GridColumnsButton" Click="GridColumnsButton_Click"
                               Background="#3498db" Foreground="White" VerticalAlignment="Center"
                               Padding="12,6" BorderThickness="0">
                            <emoji:TextBlock Text="⚙️ Columns" FontSize="12" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CONTACT LOG GRID -->
                <Border Grid.Row="2" Background="White" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="4">
                    <views:QsoLogGridView DataContext="{Binding QsoLog}"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
