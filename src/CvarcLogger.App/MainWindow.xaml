<Window x:Class="CvarcLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CvarcLogger.App.Views"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="CVARC Logger" Icon="/Assets/AppIcon.ico" Height="820" Width="1450"
        Loaded="Window_Loaded"
        Background="#f5f5f5">

    <Window.Resources>
        <Color x:Key="DoveGrey">#404040</Color>
        <Color x:Key="LightBlue">#34495e</Color>
        <Color x:Key="BlueAccent">#3498db</Color>
        <Color x:Key="StickyBg">#ecf0f1</Color>
        <SolidColorBrush x:Key="DoveGreyBrush" Color="#404040"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#34495e"/>
        <SolidColorBrush x:Key="BlueAccentBrush" Color="#3498db"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#f5f5f5"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActiveStyle" BasedOn="{StaticResource SidebarButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Shared sizing for every button on the LOG GRID RIBBON (see below) so they're all identical
             regardless of label length. Only Background/Margin vary per button. -->
        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#f5f5f5">
        <!-- TOP BANNER -->
        <Border DockPanel.Dock="Top" Background="#3498db" Height="100" Padding="20,0,20,0">
            <DockPanel>
                <Image Source="/Assets/BannerLogo.png" Height="80" DockPanel.Dock="Left" Margin="0,10,15,10" VerticalAlignment="Center"/>
                <Image Source="/Assets/218-2180558_arrl-logo-hd-png-download.png" Height="80" DockPanel.Dock="Left" Margin="0,10,15,10" VerticalAlignment="Center"/>
                <TextBlock Text="CVARC LOGGER" FontSize="36" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           FontFamily="Segoe UI, Roboto, sans-serif"/>
            </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding QsoLog.Qsos.Count, Mode=OneWay}"/>
                    <Run Text=" QSOs logged"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LogNameText"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="Program by W6CSM"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
        </StatusBar>

        <!-- MAIN CONTENT WITH SIDEBAR -->
        <Grid Background="#404040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#34495e" BorderBrush="#999999" BorderThickness="0,0,2,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="10,20,10,20">
                        <!-- File Operations Button -->
                        <Button Name="FileButton" Click="FileButton_Click" ToolTip="Import, export, or switch log database files"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📁 File"/>
                        </Button>

                        <!-- Station Configuration Button -->
                        <Button Name="StationButton" Click="StationButton_Click" ToolTip="Manage station profiles (callsign, grid, power)"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📍 Station"/>
                        </Button>

                        <!-- CAT Control Button -->
                        <Button Name="CatButton" Click="CatButton_Click" ToolTip="Configure radio CAT control settings"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📡 CAT"/>
                        </Button>

                        <!-- Lookup Sources Button -->
                        <Button Name="LookupButton" Click="LookupButton_Click" ToolTip="Configure callsign lookup sources"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🔍 Lookup"/>
                        </Button>

                        <!-- Column Visibility Button -->
                        <Button Name="ColumnsButton" Click="ColumnsButton_Click" ToolTip="Choose which fields and columns are shown"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="⚙️ Columns"/>
                        </Button>

                        <!-- Divider -->
                        <Separator Height="2" Margin="0,20,0,20" Background="#666666"/>

                        <!-- Mode Selection Buttons. Labels are bound (not hardcoded) so a rename from the
                             Column Visibility picker's Rename Tab feature (see ColumnPickerWindow /
                             QsoLogViewModel.PickerModeTabs) shows up here too. Indices 0-3 match how
                             PickerModeTabs is built (Normal, Contest, Sota, Pota, then static "All"). -->
                        <Button Name="NormalModeButton" Click="NormalMode_Click" ToolTip="Switch to Normal logging mode"
                                Style="{StaticResource SidebarButtonActiveStyle}">
                            <emoji:TextBlock Text="{Binding QsoLog.PickerModeTabs[0].Label, StringFormat='📝 {0}'}"/>
                        </Button>

                        <Button Name="ContestModeButton" Click="ContestMode_Click" ToolTip="Switch to Contest logging mode"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="{Binding QsoLog.PickerModeTabs[1].Label, StringFormat='🏆 {0}'}"/>
                        </Button>

                        <Button Name="SotaModeButton" Click="SotaMode_Click" ToolTip="Switch to SOTA logging mode"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="{Binding QsoLog.PickerModeTabs[2].Label, StringFormat='⛰️ {0}'}"/>
                        </Button>

                        <Button Name="PotaModeButton" Click="PotaMode_Click" ToolTip="Switch to POTA logging mode"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="{Binding QsoLog.PickerModeTabs[3].Label, StringFormat='🪑 {0}'}"/>
                        </Button>

                        <Button Name="AllModeButton" Click="AllMode_Click" ToolTip="Show QSOs from every mode combined"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📊 All"/>
                        </Button>

                        <!-- Divider -->
                        <Separator Height="2" Margin="0,20,0,20" Background="#666666"/>

                        <!-- Award Progress Button -->
                        <Button Name="AwardButton" Click="AwardsMenuItem_Click" ToolTip="View DXCC/WAS/SOTA/POTA award progress"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🏅 Award"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CONTENT AREA -->
            <Grid Grid.Column="1" Background="#404040" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- ENTRY FORM -->
                <Border Grid.Row="0" Background="#E8F4FC" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="4" Margin="0,0,0,15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:QsoEntryView DataContext="{Binding QsoEntry}"/>
                    </ScrollViewer>
                </Border>

                <!-- LOG GRID RIBBON: 3 equal columns, one group per column, each group centered within
                     its own column. Distributes all 3 groups evenly across the bar's full width instead
                     of clustering them to one side. Every button shares RibbonButtonStyle (see
                     Window.Resources) so they're all the same size regardless of label length. -->
                <Border Grid.Row="1" Background="#404040" BorderBrush="#cccccc" BorderThickness="2"
                        CornerRadius="4" Padding="20,12" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Group 1: CAT status indicator + Connect CAT, paired. -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12,6" Height="42" Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding QsoEntry.CatIndicatorColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#cccccc" FontSize="12" VerticalAlignment="Center" Text="{Binding QsoEntry.CatStatusText}"/>
                                </StackPanel>
                            </Border>

                            <!-- Connect CAT Button: was a MessageBox stub ("CAT Connection would be initiated
                                 here") that never actually connected anything. Now calls the same
                                 connect/disconnect toggle already used elsewhere (Hamlib or Internet CAT per
                                 Settings, see QsoEntryViewModel.ToggleCatConnectionAsync). The sidebar's CAT
                                 button is a separate, complementary action: it opens CatControlWindow to
                                 configure which backend/credentials to use, not to connect/disconnect. -->
                            <Button Name="CatConnectButton" Command="{Binding QsoEntry.ToggleCatConnectionCommand}" ToolTip="Connect or disconnect radio CAT control"
                                   Style="{StaticResource RibbonButtonStyle}" Background="#3498db">
                                <emoji:TextBlock Text="{Binding QsoEntry.CatConnectButtonLabel}" FontSize="13" Foreground="White"/>
                            </Button>
                        </StackPanel>

                        <!-- Group 2: Start + End time stamps, paired. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Start Time Button: freezes Date/Time UTC at the current instant (see
                                 QsoEntryViewModel.SetStartTime). Local Time keeps live-ticking independently. -->
                            <Button Command="{Binding QsoEntry.SetStartTimeCommand}" ToolTip="Freeze the current time into Date/Time (UTC)"
                                   Style="{StaticResource RibbonButtonStyle}" Background="#2E7D32" Margin="0,0,15,0">
                                <emoji:TextBlock Text="▶️ Start Clock" FontSize="13" Foreground="White"/>
                            </Button>

                            <!-- End Time Button: stamps the current instant into Time Off (UTC) (see
                                 QsoEntryViewModel.SetEndTime). -->
                            <Button Command="{Binding QsoEntry.SetEndTimeCommand}" ToolTip="Stamp the current time into Time Off (UTC)"
                                   Style="{StaticResource RibbonButtonStyle}" Background="#c0392b">
                                <emoji:TextBlock Text="⏹️ End Clock" FontSize="13" Foreground="White"/>
                            </Button>
                        </StackPanel>

                        <!-- Group 3: Lookup + Log QSO + Columns. Columns doesn't pair with anything else,
                             so it joins this group for now. Lookup/Log QSO moved here from the entry
                             form's bottom (see QsoEntryView.xaml) so they're reachable regardless of how
                             the form's fields scroll or how tall the current mode's layout gets. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="Call Lookup" Command="{Binding QsoEntry.LookupCommand}" ToolTip="Look up the entered callsign online"
                                   Style="{StaticResource RibbonButtonStyle}" Background="#3498db" Margin="0,0,15,0"/>
                            <Button Content="Log QSO" Command="{Binding QsoEntry.LogQsoCommand}" ToolTip="Save this contact to the log"
                                   Style="{StaticResource RibbonButtonStyle}" Background="#2E7D32" Margin="0,0,15,0"/>
                            <Button Name="GridColumnsButton" Click="GridColumnsButton_Click" ToolTip="Choose which fields and columns are shown"
                                   Style="{StaticResource RibbonButtonStyle}" Background="#3498db">
                                <emoji:TextBlock Text="⚙️ Columns" FontSize="13" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTACT LOG GRID -->
                <Border Grid.Row="2" Background="White" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="4">
                    <views:QsoLogGridView DataContext="{Binding QsoLog}"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
