<Window x:Class="CvarcLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CvarcLogger.App.Views"
        mc:Ignorable="d"
        Title="CVARC Logger" Icon="/Assets/AppIcon.ico" Height="820" Width="1450"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="DarkBlue" Padding="10,6">
            <DockPanel>
                <Image Source="/Assets/BannerLogo.png" Height="54" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBlock Text="Conejo Valley Amateur Radio Club Logger" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </DockPanel>
        </Border>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Log..." Click="NewLogMenuItem_Click"/>
                <MenuItem Header="_Open Log..." Click="OpenLogMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Import ADIF..." Command="{Binding ImportExport.ImportCommand}"/>
                <MenuItem Header="_Export ADIF..." Command="{Binding ImportExport.ExportCommand}"/>
                <Separator/>
                <MenuItem Header="_Save Log..." Click="SaveLogMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Stations">
                <MenuItem Header="_Manage Station Profiles..." Click="StationProfilesMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Awards Progress..." Click="AwardsMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Lookup..." Click="LookupMenuItem_Click"/>
                <MenuItem Header="_CAT Control..." Click="CatControlMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding QsoLog.Qsos.Count, Mode=OneWay}"/>
                    <Run Text=" QSOs logged"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LogNameText"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="Program by W6CSM"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="150"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="AliceBlue">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                    <views:QsoEntryView DataContext="{Binding QsoEntry}"/>
                </Viewbox>
            </Border>

            <views:QsoLogGridView Grid.Row="1" DataContext="{Binding QsoLog}"/>
        </Grid>
    </DockPanel>
</Window>
