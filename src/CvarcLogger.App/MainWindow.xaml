<Window x:Class="CvarcLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CvarcLogger.App.Views"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:conv="clr-namespace:CvarcLogger.App.Converters"
        mc:Ignorable="d"
        Title="CVARC Logger" Icon="/Assets/AppIcon.ico" Height="820" Width="1450"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#f5f5f5">

    <Window.Resources>
        <conv:TogglePairLabelConverter x:Key="TogglePairLabelConverter"/>
        <Color x:Key="DoveGrey">#404040</Color>
        <Color x:Key="LightBlue">#34495e</Color>
        <Color x:Key="BlueAccent">#3498db</Color>
        <Color x:Key="StickyBg">#ecf0f1</Color>
        <SolidColorBrush x:Key="DoveGreyBrush" Color="#404040"/>

        <!-- Entry form / log grid drag handle. A plain filled GridSplitter just reads as a divider line,
             so this templates in the two stacked grip lines people already recognize as "grab me", and
             lights the whole bar up in the app's accent blue on hover and while dragging. The accent
             also confirms the grab landed, which matters because the bar sits in a narrow gap and a
             near miss would otherwise be silent. -->
        <Style x:Key="EntryLogSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="#6e6e6e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="SplitterBar" Background="{TemplateBinding Background}"
                                BorderBrush="#909090" BorderThickness="1" CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="GripLineTop" Width="70" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="#dcdcdc" Margin="0,0,0,3"/>
                                <Rectangle x:Name="GripLineBottom" Width="70" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="#dcdcdc"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterBar" Property="Background" Value="#3498db"/>
                                <Setter TargetName="SplitterBar" Property="BorderBrush" Value="#5dade2"/>
                                <Setter TargetName="GripLineTop" Property="Fill" Value="White"/>
                                <Setter TargetName="GripLineBottom" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterBar" Property="Background" Value="#2E7D32"/>
                                <Setter TargetName="SplitterBar" Property="BorderBrush" Value="#4caf50"/>
                                <Setter TargetName="GripLineTop" Property="Fill" Value="White"/>
                                <Setter TargetName="GripLineBottom" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#34495e"/>
        <SolidColorBrush x:Key="BlueAccentBrush" Color="#3498db"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#f5f5f5"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActiveStyle" BasedOn="{StaticResource SidebarButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Shared sizing for every button on the LOG GRID RIBBON (see below) so they're all identical
             regardless of label length. Only Background/Margin vary per button. -->
        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#f5f5f5">
        <!-- TOP BANNER -->
        <Border DockPanel.Dock="Top" Background="#3498db" Height="100" Padding="20,0,20,0">
            <DockPanel>
                <Image Source="/Assets/BannerLogo.png" Height="80" DockPanel.Dock="Left" Margin="0,10,15,10" VerticalAlignment="Center"/>
                <Image Source="/Assets/218-2180558_arrl-logo-hd-png-download.png" Height="80" DockPanel.Dock="Left" Margin="0,10,15,10" VerticalAlignment="Center"/>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CVARC LOGGER" FontSize="36" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontFamily="Segoe UI, Roboto, sans-serif"/>
                    <TextBlock Text="Conejo Valley Amateur Radio Club" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontFamily="Segoe UI, Roboto, sans-serif"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding QsoLog.Qsos.Count, Mode=OneWay}"/>
                    <Run Text=" QSOs logged"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LogNameText"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="Program by W6CSM"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
        </StatusBar>

        <!-- MAIN CONTENT WITH SIDEBAR -->
        <Grid Background="#404040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#34495e" BorderBrush="#999999" BorderThickness="0,0,2,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="10,20,10,20">
                        <!-- File Operations Button -->
                        <Button Name="FileButton" Click="FileButton_Click" ToolTip="Import, export, or switch log database files"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📁 File Operations"/>
                        </Button>

                        <!-- Station Configuration Button -->
                        <Button Name="StationButton" Click="StationButton_Click" ToolTip="Manage station profiles (callsign, grid, power)"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📍 Station"/>
                        </Button>

                        <!-- CAT Control Button -->
                        <Button Name="CatButton" Click="CatButton_Click" ToolTip="Configure radio CAT control settings"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📡 CAT"/>
                        </Button>

                        <!-- Lookup Sources Button -->
                        <Button Name="LookupButton" Click="LookupButton_Click" ToolTip="Configure callsign lookup sources"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🔍 Lookup"/>
                        </Button>

                        <!-- Column Visibility Button -->
                        <Button Name="ColumnsButton" Click="ColumnsButton_Click" ToolTip="Choose which fields and columns are shown"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="⚙️ Columns/Tabs"/>
                        </Button>

                        <!-- Divider -->
                        <Separator Height="2" Margin="0,20,0,20" Background="#666666"/>

                        <!-- Mode Selection Buttons: two toggle tabs (each covering 2 modes; click again
                             to flip between them) plus All. Replaces the previous 1-button-per-mode
                             layout (Normal/Contest/Sota/Pota/Net/All, 6 buttons) down to 4 toggle-style
                             tabs plus All. Undef-1..4 (QsoEntryMode.Net/Custom1/Custom2/Custom3) are
                             placeholder slots with no fixed purpose; naming them and choosing which
                             fields/columns they show both happen in the Columns/Tabs window (see
                             ColumnPickerWindow), same as every other mode. See NormalContestToggle_Click
                             /SotaPotaToggle_Click/Undef1Undef2Toggle_Click/Undef3Undef4Toggle_Click in
                             the code-behind for the toggle mechanic. Labels are static "X/Y" text rather
                             than bound to PickerModeTabs' renameable labels; a future pass could stitch
                             the two together if the rename feature needs to reach these too. -->
                        <Button Name="NormalContestToggleButton" Click="NormalContestToggle_Click"
                                ToolTip="Normal / Contest: click again to switch between the two"
                                Style="{StaticResource SidebarButtonActiveStyle}">
                            <emoji:TextBlock>
                                <emoji:TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TogglePairLabelConverter}" ConverterParameter="📝 ">
                                        <Binding Path="QsoLog.PickerModeTabs[0].Label"/>
                                        <Binding Path="QsoLog.PickerModeTabs[1].Label"/>
                                    </MultiBinding>
                                </emoji:TextBlock.Text>
                            </emoji:TextBlock>
                        </Button>

                        <Button Name="SotaPotaToggleButton" Click="SotaPotaToggle_Click"
                                ToolTip="SOTA / POTA: click again to switch between the two"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock>
                                <emoji:TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TogglePairLabelConverter}" ConverterParameter="⛰️ ">
                                        <Binding Path="QsoLog.PickerModeTabs[2].Label"/>
                                        <Binding Path="QsoLog.PickerModeTabs[3].Label"/>
                                    </MultiBinding>
                                </emoji:TextBlock.Text>
                            </emoji:TextBlock>
                        </Button>

                        <Button Name="Undef1Undef2ToggleButton" Click="Undef1Undef2Toggle_Click"
                                ToolTip="Undef-1 / Undef-2: click again to switch between the two. Rename and configure fields in Columns/Tabs."
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock>
                                <emoji:TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TogglePairLabelConverter}" ConverterParameter="🔷 ">
                                        <Binding Path="QsoLog.PickerModeTabs[4].Label"/>
                                        <Binding Path="QsoLog.PickerModeTabs[5].Label"/>
                                    </MultiBinding>
                                </emoji:TextBlock.Text>
                            </emoji:TextBlock>
                        </Button>

                        <Button Name="Undef3Undef4ToggleButton" Click="Undef3Undef4Toggle_Click"
                                ToolTip="Undef-3 / Undef-4: click again to switch between the two. Rename and configure fields in Columns/Tabs."
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock>
                                <emoji:TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TogglePairLabelConverter}" ConverterParameter="🔶 ">
                                        <Binding Path="QsoLog.PickerModeTabs[6].Label"/>
                                        <Binding Path="QsoLog.PickerModeTabs[7].Label"/>
                                    </MultiBinding>
                                </emoji:TextBlock.Text>
                            </emoji:TextBlock>
                        </Button>

                        <Button Name="AllModeButton" Click="AllMode_Click" ToolTip="Show QSOs from every mode combined"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="📊 All"/>
                        </Button>

                        <!-- Divider -->
                        <Separator Height="2" Margin="0,20,0,20" Background="#666666"/>

                        <!-- Award Progress Button -->
                        <Button Name="AwardButton" Click="AwardsMenuItem_Click" ToolTip="View DXCC/WAS/SOTA/POTA award progress"
                                Style="{StaticResource SidebarButtonStyle}">
                            <emoji:TextBlock Text="🏅 Award"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CONTENT AREA -->
            <Grid Grid.Column="1" Background="#404040" Margin="20">
                <Grid.RowDefinitions>
                    <!-- Entry form and log grid split the leftover vertical space between them, an even
                         50/50 on a fresh install. Both are star sized so the GridSplitter below the
                         ribbon can trade height between them; MainWindow's Window_Loaded restores the
                         operator's last saved split and Window_Closing writes it back. MinHeight on each
                         keeps a drag to either extreme from collapsing a pane past the point where its
                         own splitter edge is still grabbable. -->
                    <RowDefinition x:Name="EntryFormRow" Height="1*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="LogGridRow" Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- ENTRY FORM -->
                <Border Grid.Row="0" Background="#E8F4FC" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="4" Margin="0,0,0,15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:QsoEntryView DataContext="{Binding QsoEntry}"/>
                    </ScrollViewer>
                </Border>

                <!-- LOG GRID RIBBON: a UniformGrid with one cell per item, all 8 cells the same width
                     (dividing the ribbon's actual available width evenly, since the UniformGrid itself
                     stretches to fill the Border); replaces the old "3 groups in 3 equal columns"
                     layout, which broke once Group 3 grew to 4 buttons and overflowed its column,
                     visually overlapping into Group 2's space ("skewed" buttons). Every button shares
                     RibbonButtonStyle (see Window.Resources) so they're all the same size regardless of
                     label length; each item is centered within its own cell. -->
                <Border Grid.Row="1" Background="#404040" BorderBrush="#cccccc" BorderThickness="2"
                        CornerRadius="4" Padding="20,12" Margin="0,0,0,15">
                    <UniformGrid Columns="8" HorizontalAlignment="Stretch">
                        <!-- CAT status indicator + Connect CAT, paired as one cell. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12,6" Height="42" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding QsoEntry.CatIndicatorColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#cccccc" FontSize="12" VerticalAlignment="Center" Text="{Binding QsoEntry.CatStatusText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Connect CAT Button: was a MessageBox stub ("CAT Connection would be initiated
                             here") that never actually connected anything. Now calls the same
                             connect/disconnect toggle already used elsewhere (Hamlib or Internet CAT per
                             Settings, see QsoEntryViewModel.ToggleCatConnectionAsync). The sidebar's CAT
                             button is a separate, complementary action: it opens CatControlWindow to
                             configure which backend/credentials to use, not to connect/disconnect. -->
                        <Button Name="CatConnectButton" Command="{Binding QsoEntry.ToggleCatConnectionCommand}" ToolTip="Connect or disconnect radio CAT control"
                               Style="{StaticResource RibbonButtonStyle}" Background="#3498db" HorizontalAlignment="Center">
                            <emoji:TextBlock Text="{Binding QsoEntry.CatConnectButtonLabel}" FontSize="13" Foreground="White"/>
                        </Button>

                        <!-- Start Time Button: freezes Date/Time UTC at the current instant (see
                             QsoEntryViewModel.SetStartTime). Local Time keeps live-ticking independently. -->
                        <Button Command="{Binding QsoEntry.SetStartTimeCommand}" ToolTip="Freeze the current time into Date/Time (UTC)"
                               Style="{StaticResource RibbonButtonStyle}" Background="#2E7D32" HorizontalAlignment="Center">
                            <emoji:TextBlock Text="▶️ Start Clock" FontSize="13" Foreground="White"/>
                        </Button>

                        <!-- End Time Button: stamps the current instant into Time Off (UTC) (see
                             QsoEntryViewModel.SetEndTime). -->
                        <Button Command="{Binding QsoEntry.SetEndTimeCommand}" ToolTip="Stamp the current time into Time Off (UTC)"
                               Style="{StaticResource RibbonButtonStyle}" Background="#c0392b" HorizontalAlignment="Center">
                            <emoji:TextBlock Text="⏹️ End Clock" FontSize="13" Foreground="White"/>
                        </Button>

                        <!-- Lookup/Log QSO moved here from the entry form's bottom (see QsoEntryView.xaml)
                             so they're reachable regardless of how the form's fields scroll or how tall
                             the current mode's layout gets. -->
                        <Button Content="Call Lookup" Command="{Binding QsoEntry.LookupCommand}" ToolTip="Look up the entered callsign online"
                               Style="{StaticResource RibbonButtonStyle}" Background="#3498db" HorizontalAlignment="Center"/>
                        <Button Content="Log QSO" Command="{Binding QsoEntry.LogQsoCommand}" ToolTip="Save this contact to the log"
                               Style="{StaticResource RibbonButtonStyle}" Background="#2E7D32" HorizontalAlignment="Center"/>
                        <Button Name="GridColumnsButton" Click="GridColumnsButton_Click" ToolTip="Choose which fields and columns are shown"
                               Style="{StaticResource RibbonButtonStyle}" Background="#3498db" HorizontalAlignment="Center">
                            <emoji:TextBlock Text="⚙️ Columns/Tabs" FontSize="13" Foreground="White"/>
                        </Button>

                        <!-- Delete acts on the log grid's current selection (QsoLog.SelectedQsos, falling
                             back to SelectedQso); it was previously missing from the UI entirely despite
                             QsoLogViewModel.DeleteSelectedCommand still existing. -->
                        <Button Content="Delete" Command="{Binding QsoLog.DeleteSelectedCommand}" ToolTip="Delete the selected QSO(s) from the log grid"
                               Style="{StaticResource RibbonButtonStyle}" Background="#c0392b" HorizontalAlignment="Center"/>
                    </UniformGrid>
                </Border>

                <!-- Drag handle for the entry form / log grid split. It shares row 1 with the ribbon
                     rather than occupying a row of its own, sitting bottom aligned inside the 15px gap
                     the ribbon Border already reserves below itself, so the button bar keeps its exact
                     position and nothing shifts. Living in row 1 is also what makes the resize work:
                     PreviousAndNext then targets rows 0 and 2, the two star sized panes, instead of the
                     Auto sized ribbon row a splitter placed anywhere else would try to stretch. Grabbing
                     it reads as dragging the button bar itself up or down, which is the intent. -->
                <GridSplitter Grid.Row="1" Height="13" Margin="0,0,0,2"
                              HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragCompleted="EntryLogSplitter_DragCompleted"
                              ToolTip="Drag up or down to resize the entry form and the log grid"
                              Style="{StaticResource EntryLogSplitterStyle}"/>

                <!-- CONTACT LOG GRID -->
                <Border Grid.Row="2" Background="White" BorderBrush="#cccccc" BorderThickness="2" CornerRadius="4">
                    <views:QsoLogGridView DataContext="{Binding QsoLog}"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
