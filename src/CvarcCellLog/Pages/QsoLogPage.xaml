<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CvarcCellLog.Pages.QsoLogPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CvarcCellLog.ViewModels"
    x:DataType="vm:QsoLogViewModel"
    Title="QSO Log">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Columns" Clicked="OnColumnsClicked" Order="Secondary" />
        <ToolbarItem Text="New QSO" Clicked="OnNewQsoClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,12,12,0">

        <SearchBar Grid.Row="0"
                   Placeholder="Search callsign, name, grid, city"
                   Text="{Binding SearchText}" />

        <!-- Built in code-behind (RebuildColumns) to match whatever columns are currently configured;
             see QsoLogPage.xaml.cs. Fixed in place above the CollectionView, so it never scrolls with
             the rows below it. -->
        <Grid Grid.Row="1" x:Name="HeaderGrid" ColumnSpacing="6" Padding="6,6" BackgroundColor="#D8DCE3" />

        <CollectionView Grid.Row="2" x:Name="QsoCollectionView" ItemsSource="{Binding Qsos}">
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyStateMessage}" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

</ContentPage>
