<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CvarcCellLog.Pages.StationProfilesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CvarcCellLog.ViewModels"
    xmlns:models="clr-namespace:CvarcLogger.Core.Models;assembly=CvarcLogger.Core"
    x:DataType="vm:StationProfileViewModel"
    Title="Station Profiles">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Profiles" FontAttributes="Bold" FontSize="16" />

            <CollectionView ItemsSource="{Binding Profiles}"
                             SelectionMode="Single"
                             SelectedItem="{Binding SelectedProfile}"
                             HeightRequest="160">
                <CollectionView.EmptyView>
                    <Label Text="No station profiles yet. Add one below." TextColor="Gray" Margin="0,10,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StationProfile">
                        <Grid Padding="8,10" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding Callsign}" FontAttributes="Bold" FontSize="15" />
                            <Label Grid.Column="1" Text="Default" FontSize="12" TextColor="Gray"
                                   VerticalOptions="Center" IsVisible="{Binding IsDefault}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="New Profile" Command="{Binding NewProfileCommand}" Padding="0,10" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />

            <Label Text="{Binding ErrorMessage}" TextColor="#C0392B" IsVisible="{Binding HasErrorMessage}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Callsign *" FontSize="11" TextColor="Gray" />
                    <Entry Text="{Binding EditCallsign}" MaxLength="10" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Operator Callsign (if different)" FontSize="11" TextColor="Gray" />
                    <Entry Text="{Binding EditOperatorCallsign}" MaxLength="10" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="My Grid Square" FontSize="11" TextColor="Gray" />
                    <Entry Text="{Binding EditMyGridSquare}" MaxLength="6" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="My State" FontSize="11" TextColor="Gray" />
                    <Entry Text="{Binding EditMyState}" MaxLength="2" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="My County" FontSize="11" TextColor="Gray" />
            <Entry Text="{Binding EditMyCounty}" />

            <Label Text="QTH" FontSize="11" TextColor="Gray" />
            <Entry Text="{Binding EditQth}" />

            <Label Text="OP (Operator Name)" FontSize="11" TextColor="Gray" />
            <Entry Text="{Binding EditOp}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="UTC Offset (hours) *" FontSize="11" TextColor="Gray" />
                    <Entry Text="{Binding EditUtcOffsetHours}" MaxLength="3" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="End" Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding EditObservesDaylightSavingTime}" />
                    <Label Text="DST" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding EditIsDefault}" />
                <Label Text="Default station profile" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Button Text="Delete" Clicked="OnDeleteClicked" BackgroundColor="#C0392B" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
