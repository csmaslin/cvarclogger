<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CvarcCellLog.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CVARC Cell Logger"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">

            <Image Source="bannerlogo.png" HeightRequest="140" Aspect="AspectFit" Margin="0,0,0,4" />

            <Label Text="CVARC Cell Logger" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Conejo Valley Amateur Radio Club" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
            <Label x:Name="VersionLabel" FontSize="12" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Button Text="File" Clicked="OnFileClicked" Padding="0,14" FontSize="18" />
            <Button Text="Station" Clicked="OnStationClicked" Padding="0,14" FontSize="18" />
            <Button Text="View" Clicked="OnViewClicked" Padding="0,14" FontSize="18" />
            <Button Text="Awards" Clicked="OnAwardsClicked" Padding="0,14" FontSize="18" />
            <Button Text="Tools" Clicked="OnToolsClicked" Padding="0,14" FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
