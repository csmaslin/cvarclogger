<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CvarcCellLog.Pages.LogColumnsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CvarcCellLog.ViewModels"
    x:DataType="vm:LogColumnsViewModel"
    Title="Columns">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Done" Clicked="OnDoneClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16">
        <Label Grid.Row="0" Text="Choose which fields show as columns in the QSO Log, and use the arrows to reorder them."
               FontSize="12" TextColor="Gray" Margin="0,0,0,10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogColumnItemViewModel">
                    <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" />
                        <Label Grid.Column="1" Text="{Binding Header}" VerticalOptions="Center" FontSize="15" />
                        <Button Grid.Column="2" Text="&#8593;" FontSize="14" Padding="12,4" Margin="0,0,4,0"
                                Command="{Binding BindingContext.MoveUpCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3" Text="&#8595;" FontSize="14" Padding="12,4"
                                Command="{Binding BindingContext.MoveDownCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
