<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CvarcCellLog.Pages.FileMenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="File">

    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Start">
        <Button Text="New Log..." Clicked="OnNewLogClicked" Padding="0,14" FontSize="16" />
        <Button Text="Open Log..." Clicked="OnOpenLogClicked" Padding="0,14" FontSize="16" />
        <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,6" />
        <Button Text="Import ADIF..." Clicked="OnImportAdifClicked" Padding="0,14" FontSize="16" />
        <Button Text="Export ADIF..." Clicked="OnExportAdifClicked" Padding="0,14" FontSize="16" />
    </VerticalStackLayout>

</ContentPage>
