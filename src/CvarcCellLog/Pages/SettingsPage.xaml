<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CvarcCellLog.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CvarcCellLog.ViewModels"
    xmlns:services="clr-namespace:CvarcCellLog.Services"
    xmlns:converters="clr-namespace:CvarcCellLog.Converters"
    x:DataType="vm:SettingsViewModel"
    Title="Settings">

    <ContentPage.Resources>
        <converters:PasswordVisibilityTextConverter x:Key="PasswordVisibilityTextConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Callsign Lookup" FontAttributes="Bold" FontSize="16" />

            <Label Text="Preferred Lookup Service" FontSize="11" TextColor="Gray" />
            <Picker ItemsSource="{Binding LookupServicePreferences}"
                    SelectedItem="{Binding PreferredLookupService}" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />

            <Label Text="QRZ.com" FontAttributes="Bold" FontSize="14" />
            <Label Text="{Binding QrzStatusText}" FontSize="12" TextColor="Gray" />

            <Label Text="Username" FontSize="11" TextColor="Gray" />
            <Entry Text="{Binding QrzUsername}" />

            <Label Text="Password" FontSize="11" TextColor="Gray" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding QrzPassword}" IsPassword="{Binding QrzPasswordHidden}" />
                <Button Grid.Column="1" Text="{Binding QrzPasswordHidden, Converter={StaticResource PasswordVisibilityTextConverter}}"
                        Command="{Binding ToggleQrzPasswordVisibilityCommand}" FontSize="12" Padding="10,0" />
            </Grid>

            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                <Button Text="Save" Command="{Binding SaveQrzCredentialsCommand}" />
                <Button Text="Clear" Command="{Binding ClearQrzCredentialsCommand}" BackgroundColor="#C0392B" TextColor="White" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />

            <Label Text="QRZCQ.com" FontAttributes="Bold" FontSize="14" />
            <Label Text="{Binding QrzCqStatusText}" FontSize="12" TextColor="Gray" />

            <Label Text="Username" FontSize="11" TextColor="Gray" />
            <Entry Text="{Binding QrzCqUsername}" />

            <Label Text="Password" FontSize="11" TextColor="Gray" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding QrzCqPassword}" IsPassword="{Binding QrzCqPasswordHidden}" />
                <Button Grid.Column="1" Text="{Binding QrzCqPasswordHidden, Converter={StaticResource PasswordVisibilityTextConverter}}"
                        Command="{Binding ToggleQrzCqPasswordVisibilityCommand}" FontSize="12" Padding="10,0" />
            </Grid>

            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                <Button Text="Save" Command="{Binding SaveQrzCqCredentialsCommand}" />
                <Button Text="Clear" Command="{Binding ClearQrzCqCredentialsCommand}" BackgroundColor="#C0392B" TextColor="White" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
